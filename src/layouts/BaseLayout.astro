---
import '@fontsource-variable/bricolage-grotesque/wdth.css';
import '@fontsource-variable/ibm-plex-sans';
import displayWoff2 from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wdth-normal.woff2?url';
// El fichero que de verdad pide la hoja de estilos es el del eje de peso;
// precargar el 'standard' descargaba uno que nadie usaba
import bodyWoff2 from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/typography.css';

import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import ContactCTA from '../components/global/ContactCTA.astro';
import MusicToggle from '../components/global/MusicToggle.astro';
import { company, type Locale } from '../data/company';
import { useTranslations } from '../i18n/utils';
import { withBase } from '../lib/base';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Ruta equivalente en el otro idioma, para hreflang y el conmutador. */
  alternatePath?: string;
  ogImage?: string;
  /** Ocultar CTA móvil (p. ej. en la propia página de contacto). */
  hideContactCta?: boolean;
  /** Nodos extra para el @graph: ficha de producto, FAQ, lo que aporte la página. */
  schema?: Record<string, unknown>[];
  /** Migas con rutas ya resueltas; se publican como BreadcrumbList. */
  breadcrumbs?: { name: string; path?: string }[];
}

const {
  locale,
  title,
  description,
  alternatePath,
  ogImage = '/social/og-default.jpg',
  hideContactCta = false,
  schema = [],
  breadcrumbs = [],
} = Astro.props;

const t = useTranslations(locale);
// Astro.url.pathname ya incluye el base; el resto de rutas hay que prefijarlas.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(withBase(ogImage), Astro.site);
const alternateLocale: Locale = locale === 'es' ? 'en' : 'es';
const alternateUrl = alternatePath ? new URL(withBase(alternatePath), Astro.site) : null;
const xDefaultUrl = locale === 'es' ? canonical : alternateUrl;
const siteRoot = new URL(withBase('/'), Astro.site).toString();

// Datos estructurados: solo hechos reales (spec §19/§32)
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: company.name,
      url: siteRoot,
      logo: new URL(withBase('/icon-512.png'), Astro.site).toString(),
      sameAs: [company.social.github].filter(Boolean),
    },
    {
      '@type': 'WebSite',
      name: company.name,
      url: siteRoot,
      inLanguage: ['es', 'en'],
    },
    ...(breadcrumbs.length > 1
      ? [
          {
            '@type': 'BreadcrumbList',
            itemListElement: breadcrumbs.map((crumb, index) => ({
              '@type': 'ListItem',
              position: index + 1,
              name: crumb.name,
              ...(crumb.path ? { item: new URL(crumb.path, Astro.site).toString() } : {}),
            })),
          },
        ]
      : []),
    ...schema,
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="512x512" href={withBase('/icon-512.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0B1220" />

    <link rel="preload" as="font" type="font/woff2" href={displayWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bodyWoff2} crossorigin />

    {alternateUrl && <link rel="alternate" hreflang={alternateLocale} href={alternateUrl} />}
    {alternateUrl && <link rel="alternate" hreflang={locale} href={canonical} />}
    {xDefaultUrl && <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <ClientRouter />
  </head>
  <body>
    <!-- El escenario es fijo y persiste entre páginas: los haces acompañan
         todo el recorrido en vez de quedarse en la portada. -->
    <div class="bg-scene" aria-hidden="true" transition:persist>
      <span class="blob blob-1"></span>
      <span class="blob blob-2"></span>
      <span class="blob blob-3"></span>
      <canvas class="particles"></canvas>
      <span class="beam beam-1"></span>
      <span class="beam beam-2"></span>
      <span class="beam beam-3"></span>
      <span class="beam beam-4"></span>
    </div>
    <!-- Luz guía: baja con el scroll y late muy despacio -->
    <div class="guide-light" aria-hidden="true" transition:persist></div>
    <div class="cursor-glow" aria-hidden="true" transition:persist></div>
    <div class="grain" aria-hidden="true" transition:persist></div>
    <div class="progress-track" aria-hidden="true"><div class="progress-fill"></div></div>
    <a href="#main" class="skip-link">{t('skip.main')}</a>
    <Header locale={locale} alternatePath={alternatePath} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    {!hideContactCta && <ContactCTA locale={locale} />}
    <MusicToggle locale={locale} variant="bubble" />
    <!-- preload="none": el archivo solo se descarga si encienden la música.
         transition:persist mantiene el mismo elemento entre páginas, así la
         canción no se corta al navegar. -->
    <audio
      data-music-track
      src={withBase('/audio/ambient.mp3')}
      loop
      preload="none"
      transition:persist></audio>
    <script src="../scripts/motion.ts"></script>
  </body>
</html>

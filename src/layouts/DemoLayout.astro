---
/**
 * Armazón de las plantillas de demostración.
 *
 * No lleva nada de la web de MAI —ni cabecera, ni pie, ni el escenario de
 * fondo—: una plantilla tiene que verse como la web del cliente, no como la
 * nuestra. Va con noindex: son ejemplos, no deben competir en el buscador
 * con las páginas reales.
 */
interface Props {
  title: string;
  description: string;
  /** Familia tipográfica ya instalada; cada plantilla usa la suya. */
  fontImport?: 'inter' | 'plex' | 'space' | 'bricolage';
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <slot name="head" />
  </head>
  <body>
    <slot />

    <!-- Aviso fijo: quien llegue suelto a esta página debe saber qué es -->
    <p class="demo-flag">Plantilla de ejemplo · MAI Softwares · contenido ficticio</p>

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        -webkit-font-smoothing: antialiased;
      }

      img {
        max-width: 100%;
        display: block;
      }

      a {
        color: inherit;
      }

      .demo-flag {
        position: fixed;
        inset: auto 0 0 0;
        z-index: 99;
        margin: 0;
        padding: 0.45rem 1rem;
        background: rgba(8, 10, 18, 0.88);
        color: #e7ecf7;
        font: 500 0.72rem/1.4 system-ui, sans-serif;
        letter-spacing: 0.04em;
        text-align: center;
        backdrop-filter: blur(8px);
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          transition-duration: 0.001ms !important;
        }
      }
    </style>
  </body>
</html>

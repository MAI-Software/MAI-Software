---
import { company, type Locale } from '../../data/company';
import { useTranslations } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const accessKey = company.contact.web3formsKey;
---

<form class="contact-form panel" data-contact-form action="https://api.web3forms.com/submit" method="POST">
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="from_name" value={company.name} />
  <input type="hidden" name="subject" value={`Nuevo mensaje desde ${company.name}`} />

  <!-- Trampa antispam: invisible para personas, la rellenan los bots -->
  <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />

  <div class="field">
    <label for="cf-name">{t('form.name')}</label>
    <input id="cf-name" name="name" type="text" required autocomplete="name" />
  </div>

  <div class="field">
    <label for="cf-email">{t('form.email')}</label>
    <input id="cf-email" name="email" type="email" required autocomplete="email" />
  </div>

  <div class="field">
    <label for="cf-message">{t('form.message')}</label>
    <textarea
      id="cf-message"
      name="message"
      rows="5"
      required
      placeholder={t('form.messagePlaceholder')}
      data-prefill={t('upcoming.prefill')}></textarea>
  </div>

  <button type="submit" class="btn btn-primary form-submit" data-done={t('form.done')}>
    <svg class="check" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path
        d="m4 12.5 5.2 5.2L20 7"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    <span class="form-submit-label">{t('form.send')}</span>
  </button>

  <!-- Los mensajes de estado se anuncian a los lectores de pantalla -->
  <p class="form-status" role="status" aria-live="polite" data-ok={t('form.ok')} data-error={t('form.error')} data-sending={t('form.sending')}></p>
</form>

<script>
  function bindContactForm() {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    /* Quien llega desde "Avísame cuando esté" encuentra el mensaje escrito:
       el parámetro solo lleva el nombre del proyecto. */
    const app = new URLSearchParams(location.search).get('aviso');
    if (app) {
      const message = form.querySelector<HTMLTextAreaElement>('[data-prefill]');
      if (message && !message.value) {
        message.value = (message.dataset.prefill ?? '').replace('{app}', app);
        form.scrollIntoView({ block: 'center' });
        form.querySelector<HTMLInputElement>('#cf-name')?.focus();
      }
    }

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();

      const status = form.querySelector<HTMLElement>('.form-status');
      const submit = form.querySelector<HTMLButtonElement>('.form-submit');
      if (!status || !submit) return;

      const label = submit.querySelector<HTMLElement>('.form-submit-label');
      if (!label) return;
      const original = label.textContent;
      submit.disabled = true;
      submit.classList.add('is-sending');
      label.textContent = status.dataset.sending ?? '';
      status.textContent = '';
      status.classList.remove('is-ok', 'is-error');

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });

        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        status.textContent = status.dataset.ok ?? '';
        status.classList.add('is-ok');
        form.reset();

        /* El botón confirma el envío antes de volver a su sitio: el mensaje
           de estado por sí solo pasa desapercibido. */
        submit.classList.remove('is-sending');
        submit.classList.add('is-done');
        label.textContent = submit.dataset.done ?? '';
        window.setTimeout(() => {
          submit.classList.remove('is-done');
          label.textContent = original;
          submit.disabled = false;
        }, 2200);
        return;
      } catch {
        status.textContent = status.dataset.error ?? '';
        status.classList.add('is-error');
      }

      submit.classList.remove('is-sending');
      submit.disabled = false;
      label.textContent = original;
    });
  }

  bindContactForm();
  document.addEventListener('astro:after-swap', bindContactForm);
</script>

<style>
  /* Enviado: el botón se vuelve verde y dibuja el visto.
     El icono va en el marcado y no en ::before/::after, que ya los ocupa
     la onda de pulsación. */
  .form-submit.is-done {
    background-image: none;
    background-color: var(--success);
    color: var(--ink-950);
    box-shadow: 0 18px 40px -20px rgba(52, 211, 153, 0.9);
  }

  .form-submit .check {
    width: 0;
    height: 18px;
    opacity: 0;
    overflow: visible;
    transition:
      width 240ms var(--ease-spring),
      opacity 160ms var(--ease-standard);
  }

  .form-submit.is-done .check {
    width: 18px;
    opacity: 1;
  }

  .form-submit .check path {
    stroke-dasharray: 22;
    stroke-dashoffset: 22;
  }

  .form-submit.is-done .check path {
    animation: check-draw 320ms var(--ease-standard) 120ms forwards;
  }

  @keyframes check-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .form-submit.is-sending {
    opacity: 0.85;
  }

  @media (prefers-reduced-motion: reduce) {
    .form-submit .check path {
      stroke-dashoffset: 0;
    }

    .form-submit.is-done .check path {
      animation: none;
    }
  }

  .contact-form {
    display: grid;
    gap: var(--space-5);
    padding: clamp(var(--space-5), 4vw, var(--space-7));
    width: 100%;
    max-width: 34rem;
  }

  /* Trampa antispam */
  .hp {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .field {
    display: grid;
    gap: var(--space-2);
  }

  label {
    font-family: var(--font-display);
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--text);
  }

  input[type='text'],
  input[type='email'],
  textarea {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    /* 16px evita el zoom automático en iOS al enfocar */
    font-size: var(--font-size-base);
    color: var(--text);
    background: var(--ink-850);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    transition:
      border-color var(--duration-base) var(--ease-standard),
      background-color var(--duration-base) var(--ease-standard);
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--text-soft);
  }

  input:hover,
  textarea:hover {
    border-color: var(--line-strong);
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--blue);
    background: var(--ink-800);
    box-shadow: 0 0 0 3px rgba(56, 130, 251, 0.22);
  }

  textarea {
    resize: vertical;
    min-height: 8rem;
    font-family: inherit;
    line-height: 1.6;
  }

  .form-submit {
    justify-self: start;
  }

  .form-submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .form-status {
    margin: 0;
    font-size: var(--font-size-sm);
    min-height: 1.2em;
  }

  .form-status.is-ok {
    color: var(--success);
  }

  .form-status.is-error {
    color: var(--danger);
  }
</style>

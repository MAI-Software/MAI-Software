---
interface Props {
  /** Rutas ya resueltas (con base). El último elemento es la página actual. */
  items: { name: string; path?: string }[];
  label: string;
}

const { items, label } = Astro.props;
---

<nav class="breadcrumbs" aria-label={label}>
  <ol>
    {
      items.map((item, index) => {
        const last = index === items.length - 1;
        return (
          <li>
            {item.path && !last ? (
              <a href={item.path}>{item.name}</a>
            ) : (
              <span aria-current={last ? 'page' : undefined}>{item.name}</span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--font-size-sm);
    color: var(--text-muted);
  }

  /* La barra separadora se dibuja en CSS: no debe leerla el lector de pantalla */
  .breadcrumbs li + li::before {
    content: '/';
    margin-right: var(--space-2);
    color: var(--text-soft);
  }

  .breadcrumbs a {
    color: var(--text-muted);
    text-decoration: none;
    /* El enlace es pequeño; el área de toque llega a 44px sin moverlo */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .breadcrumbs a:hover,
  .breadcrumbs a:focus-visible {
    color: var(--text);
  }

  .breadcrumbs [aria-current='page'] {
    color: var(--text);
  }
</style>

---
import { company, type Locale } from '../../data/company';
import { footerGroups } from '../../data/navigation';
import { useTranslations, homePath } from '../../i18n/utils';
import { withBase } from '../../lib/base';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();

const socialLinks = [
  { label: 'GitHub', url: company.social.github },
  { label: 'LinkedIn', url: company.social.linkedin },
  { label: 'X', url: company.social.x },
  { label: 'Instagram', url: company.social.instagram },
  { label: 'YouTube', url: company.social.youtube },
].filter((s) => s.url !== '');

/* Columna 1: marca y contacto. Columna 2: lo que hacemos. Columna 3: el
   estudio y lo legal, que son listas cortas y comparten columna. */
const [exploreGroup, ...restGroups] = footerGroups;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href={homePath(locale)} aria-label={company.name}>
          <img src={withBase('/brand/logo-light.webp')} alt="" width="88" height="35" />
          <span class="visually-hidden">{company.name}</span>
        </a>
        <p>{company.description[locale]}</p>

        {
          (company.contact.email || socialLinks.length > 0) && (
            <div class="footer-contact">
              <h2 class="footer-title">{t('footer.contactTitle')}</h2>
              {company.contact.email && (
                <a href={`mailto:${company.contact.email}`} class="footer-email">
                  {company.contact.email}
                </a>
              )}
              {socialLinks.length > 0 && (
                <ul class="footer-social">
                  {socialLinks.map((s) => (
                    <li>
                      <a href={s.url} rel="noopener noreferrer" target="_blank">
                        {s.label} ↗
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          )
        }
      </div>

      <nav class="footer-col" aria-labelledby="footer-group-explore">
        <h2 class="footer-title" id="footer-group-explore">{t(exploreGroup.titleKey)}</h2>
        <ul>
          {
            exploreGroup.items.map((item) => (
              <li>
                <a href={item.href[locale]}>{item.label[locale]}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer-col footer-col--split">
        {
          restGroups.map((group, i) => (
            <nav aria-labelledby={`footer-group-${i}`}>
              <h2 class="footer-title" id={`footer-group-${i}`}>
                {t(group.titleKey)}
              </h2>
              <ul>
                {group.items.map((item) => (
                  <li>
                    <a href={item.href[locale]}>{item.label[locale]}</a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <div class="footer-bottom">
      <span class="brand-rule" aria-hidden="true"></span>
      <p class="footer-copy">© {year} {company.name}. {t('footer.rights')}</p>
    </div>
  </div>
</footer>

<style>
  /* Fondo opaco y más oscuro que el resto: corta las luces del escenario,
     que llegaban hasta aquí y se comían el contraste de los enlaces. */
  .site-footer {
    position: relative;
    z-index: var(--z-base);
    margin-top: clamp(var(--space-8), 8vw, var(--space-10));
    padding-block: var(--space-9) var(--space-6);
    border-top: 1px solid var(--line);
    background: var(--ink-1000);
  }

  .footer-top {
    display: grid;
    gap: var(--space-7);
  }

  .footer-brand p {
    margin-top: var(--space-4);
    max-width: 34ch;
    color: var(--text-muted);
    font-size: var(--font-size-sm);
  }

  .footer-contact {
    margin-top: var(--space-6);
  }

  /* Título de cada bloque: marca de qué va la columna sin gritar. */
  .footer-title {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
  }

  .footer-col ul,
  .footer-social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .footer-col a,
  .footer-social a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: var(--font-size-sm);
    transition: color var(--duration-base) var(--ease-standard);
  }

  .footer-col a:hover,
  .footer-social a:hover {
    color: var(--cyan);
  }

  .footer-email {
    display: inline-block;
    margin-bottom: var(--space-4);
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-standard);
  }

  .footer-email:hover {
    color: var(--cyan);
  }

  /* Estudio y Legal son de dos enlaces cada una: comparten columna en vez
     de dejar dos huecos casi vacíos. */
  .footer-col--split {
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }

  .footer-bottom {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .footer-copy {
    font-size: var(--font-size-sm);
    /* --text-soft se queda en 4.43:1 sobre este fondo, por debajo del 4.5
       que pide WCAG AA para texto normal. */
    color: var(--text-muted);
  }

  @media (min-width: 600px) {
    .footer-top {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 900px) {
    .footer-top {
      grid-template-columns: 1.6fr 1fr 1fr;
      gap: var(--space-8);
    }

    .footer-brand {
      grid-column: auto;
    }
  }
</style>

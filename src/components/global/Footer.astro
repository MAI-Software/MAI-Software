---
import { company, type Locale } from '../../data/company';
import { footerNav } from '../../data/navigation';
import { categories } from '../../data/categories';
import { useTranslations, homePath } from '../../i18n/utils';
import { withBase } from '../../lib/base';
import { getActiveCategories } from '../../lib/projects';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();

// Mismo criterio que la cabecera: fuera las disciplinas sin proyectos
const categoryPaths = new Set(categories.map((c) => c.path[locale]));
const activePaths = new Set(
  (await getActiveCategories(locale)).map((c) => c.path[locale]),
);
const nav = footerNav.filter(
  (item) => !categoryPaths.has(item.href[locale]) || activePaths.has(item.href[locale]),
);

const socialLinks = [
  { label: 'GitHub', url: company.social.github },
  { label: 'LinkedIn', url: company.social.linkedin },
  { label: 'X', url: company.social.x },
  { label: 'Instagram', url: company.social.instagram },
  { label: 'YouTube', url: company.social.youtube },
].filter((s) => s.url !== '');
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href={homePath(locale)} aria-label={company.name}>
          <img src={withBase('/brand/logo-light.webp')} alt="" width="88" height="35" />
          <span class="visually-hidden">{company.name}</span>
        </a>
        <p>{company.description[locale]}</p>
      </div>

      <nav class="footer-nav" aria-label={t('nav.menu')}>
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href[locale]}>{item.label[locale]}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      {
        (socialLinks.length > 0 || company.contact.email) && (
          <div class="footer-social">
            {company.contact.email && (
              <a href={`mailto:${company.contact.email}`} class="footer-email">
                {company.contact.email}
              </a>
            )}
            <ul>
              {socialLinks.map((s) => (
                <li>
                  <a href={s.url} rel="noopener noreferrer" target="_blank">
                    {s.label} ↗
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>

    <div class="footer-bottom">
      <span class="brand-rule" aria-hidden="true"></span>
      <p class="footer-copy">© {year} {company.name}. {t('footer.rights')}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: clamp(var(--space-8), 8vw, var(--space-10));
    padding-block: var(--space-9) var(--space-6);
    border-top: 1px solid var(--line);
    background: linear-gradient(180deg, transparent, rgba(98, 66, 252, 0.06));
  }

  .footer-top {
    display: grid;
    gap: var(--space-7);
  }

  .footer-brand p {
    margin-top: var(--space-4);
    max-width: 34ch;
    color: var(--text-muted);
    font-size: var(--font-size-sm);
  }

  .footer-nav ul,
  .footer-social ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .footer-nav a,
  .footer-social a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: var(--font-size-sm);
    transition: color var(--duration-base) var(--ease-standard);
  }

  .footer-nav a:hover,
  .footer-social a:hover {
    color: var(--cyan);
  }

  .footer-social {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .footer-email {
    font-family: var(--font-display);
    font-weight: 600;
  }

  .footer-bottom {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .footer-copy {
    font-size: var(--font-size-sm);
    color: var(--text-soft);
  }

  @media (min-width: 768px) {
    .footer-top {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }
</style>

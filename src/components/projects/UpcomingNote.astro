---
import type { Locale } from '../../data/company';
import { useTranslations, contactPath } from '../../i18n/utils';

interface Props {
  locale: Locale;
  /** Frase del frontmatter: qué se está construyendo. */
  text: string;
  /** Nombre del proyecto; viaja al formulario para saber por qué escriben. */
  project: string;
}

const { locale, text, project } = Astro.props;
const t = useTranslations(locale);
// Solo el nombre del proyecto: nada personal viaja en la URL
const href = `${contactPath(locale)}?aviso=${encodeURIComponent(project)}`;
---

<aside class="upcoming" data-reveal>
  <p class="badge badge-soon">{t('projects.soon')}</p>
  <h2>{t('upcoming.title')}</h2>
  <p class="upcoming-text">{text}</p>
  <a href={href} class="btn btn-primary">{t('upcoming.cta')}</a>
</aside>

<style>
  .upcoming {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    margin-block: var(--space-7);
    padding: clamp(var(--space-5), 4vw, var(--space-7));
    border: 1px solid rgba(16, 200, 252, 0.28);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(16, 200, 252, 0.1), transparent 60%),
      var(--card);
  }

  .upcoming h2 {
    font-size: var(--font-size-xl);
    margin: 0;
  }

  .upcoming-text {
    margin: 0;
    max-width: 60ch;
    color: var(--text-muted);
  }
</style>

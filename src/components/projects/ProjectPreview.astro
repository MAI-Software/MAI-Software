---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../data/company';
import { getCategory } from '../../data/categories';
import { useTranslations, projectPath } from '../../i18n/utils';
import { withBase } from '../../lib/base';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
  headingLevel?: 'h2' | 'h3';
}

const { project, locale, headingLevel = 'h3' } = Astro.props;
const t = useTranslations(locale);
const data = project.data;
const category = getCategory(data.category);
const href = projectPath(locale, data.slug);
const Heading = headingLevel;
---

<article class="card project-card" data-reveal>
  <a href={href} class="card-cover mockup" tabindex="-1" aria-hidden="true">
    <span class="mockup-bar">
      <span></span>
      <span></span>
      <span></span>
    </span>
    <img src={withBase(data.cover)} alt={data.coverAlt} width="1280" height="800" loading="lazy" />
  </a>

  <div class="card-meta">
    <span class="card-category">{category.label[locale]}</span>
    <span class="meta">{data.year}</span>
    {data.demoUrl && <span class="badge badge-live">{t('projects.live')}</span>}
    {data.example && <span class="badge badge-example">{t('projects.example')}</span>}
  </div>

  <Heading class="card-title">
    <a href={href}>{data.title}</a>
  </Heading>

  <p class="card-excerpt">{data.excerpt}</p>

  {
    data.technologies.length > 0 && (
      <ul class="tag-list" aria-label={t('projects.tech')}>
        {data.technologies.map((tech) => (
          <li>{tech}</li>
        ))}
      </ul>
    )
  }

  <div class="card-actions">
    <a href={href} class="link-editorial">{t('cta.viewProject')}</a>
    {
      data.demoUrl && (
        <a href={data.demoUrl} class="link-editorial" target="_blank" rel="noopener noreferrer">
          {t('cta.openDemo')}
        </a>
      )
    }
  </div>
</article>

<style>
  .project-card {
    padding: 0;
    gap: 0;
  }

  .card-cover {
    display: block;
    border-radius: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
  }

  .card-cover img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-standard);
  }

  @media (hover: hover) {
    .project-card:hover .card-cover img {
      transform: scale(1.05);
    }
  }

  .card-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-5) 0;
  }

  .card-category {
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  .card-title {
    padding: var(--space-3) var(--space-5) 0;
    /* Nombres largos de una sola palabra no deben desbordar la tarjeta */
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  .card-title a {
    color: var(--color-white);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-standard);
  }

  .card-title a:hover {
    color: var(--cyan);
  }

  .card-excerpt {
    padding: var(--space-3) var(--space-5) 0;
    color: var(--text-muted);
    font-size: var(--font-size-sm);
  }

  .project-card .tag-list {
    padding: var(--space-4) var(--space-5) 0;
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    padding: var(--space-5);
    margin-top: auto;
  }
</style>

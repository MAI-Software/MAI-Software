---
import type { Locale } from '../../data/company';
import { useTranslations } from '../../i18n/utils';
import { withBase } from '../../lib/base';
import { highlightTitle } from '../../lib/highlight';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const studioHref = withBase(locale === 'es' ? '/estudio' : '/en/studio');
---

<section class="section section-line">
  <div class="container studio-inner" data-reveal-group>
    <span class="brand-rule" aria-hidden="true" data-reveal></span>
    <h2 data-reveal set:html={highlightTitle(t('studio.title'))} />
    <p class="lead" data-reveal>{t('studio.text')}</p>
    <a href={studioHref} class="link-editorial" data-reveal>{t('studio.link')}</a>
  </div>
</section>

<style>
  /* Sin max-width aquí: el contenedor se centraba más estrecho que el del
     resto de secciones y este bloque quedaba metido hacia dentro. El ancho
     de lectura se limita en el texto, no en la caja. */
  .studio-inner {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  /* Ancho para que cada frase ocupe su línea: el corte lo marca el texto,
     no el ancho de la caja. */
  .studio-inner h2 {
    max-width: 30ch;
  }

  .studio-inner .lead {
    max-width: 58ch;
  }
</style>

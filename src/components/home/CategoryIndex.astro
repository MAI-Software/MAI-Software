---
import type { Locale } from '../../data/company';
import { useTranslations } from '../../i18n/utils';
import type { UIKey } from '../../i18n/ui';
import { categories } from '../../data/categories';
import { highlightTitle } from '../../lib/highlight';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
/* Se anuncian todas las disciplinas que ofrece el estudio, tenga o no
   proyectos publicados cada una: son servicios, no un inventario. */
// El titular cuenta las disciplinas, así nunca contradice a las tarjetas
const numberWords: Record<Locale, string[]> = {
  es: ['', '', 'Dos', 'Tres', 'Cuatro', 'Cinco', 'Seis'],
  en: ['', '', 'Two', 'Three', 'Four', 'Five', 'Six'],
};
const count = categories.length;
const title =
  count === 1
    ? t('categories.title.one')
    : t('categories.title').replace('{n}', numberWords[locale][count] ?? String(count));

const bulletKeys = (id: string): UIKey[] =>
  [`category.${id}.b1`, `category.${id}.b2`, `category.${id}.b3`] as UIKey[];
---

<section class="section section-line">
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="eyebrow">{t('categories.eyebrow')}</p>
      <h2 set:html={highlightTitle(title)} />
    </header>

    <ol class="category-grid" data-reveal-group style={`--cols:${Math.min(count, 4)}`}>
      {
        categories.map((cat) => (
          <li class="card category-card" data-reveal>
            <div class="category-top">
              <span class="card-chip">{cat.number}</span>
              <h3>{cat.label[locale]}</h3>
            </div>
            <ul class="card-bullets">
              {bulletKeys(cat.id).map((key) => (
                <li>{t(key)}</li>
              ))}
            </ul>
            <a href={cat.path[locale]} class="link-editorial category-link">
              {t('categories.cta')}
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .category-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .category-card {
    min-height: 260px;
  }

  .category-top {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .category-link {
    margin-top: auto;
    justify-self: start;
  }

  @media (min-width: 700px) {
    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    /* Tantas columnas como disciplinas haya: sin huecos si alguna se cae */
    .category-grid {
      grid-template-columns: repeat(var(--cols, 4), 1fr);
    }
  }
</style>

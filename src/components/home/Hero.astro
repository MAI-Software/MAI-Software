---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../data/company';
import { getCategory } from '../../data/categories';
import { useTranslations, projectsPath, contactPath, projectPath } from '../../i18n/utils';
import { withBase } from '../../lib/base';

interface Props {
  locale: Locale;
  projects: CollectionEntry<'projects'>[];
}

const { locale, projects } = Astro.props;
const t = useTranslations(locale);

// Última palabra del H1 con gradiente de marca
const title = t('hero.title');
const cut = title.lastIndexOf(' ');
const titleStart = title.slice(0, cut);
const titleEnd = title.slice(cut + 1);

// Pila de vistas previas reales: el hero enseña producto, no adornos
const previews = projects.slice(0, 3);
const live = projects.filter((p) => p.data.demoUrl).length;
---

<section class="hero" data-mouse-parallax>
  <div class="lamp" aria-hidden="true"></div>
  <div class="brand-shape shape-1" data-mouse-depth="26" aria-hidden="true"></div>
  <div class="brand-shape shape-2" data-mouse-depth="16" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-copy" data-reveal-group>
      <p class="eyebrow" data-reveal>{t('hero.eyebrow')}</p>
      <h1 data-reveal>
        {titleStart}{' '}<span class="grad-text">{titleEnd}</span>
      </h1>
      <p class="lead hero-lead" data-reveal>{t('hero.text')}</p>

      <div class="hero-actions" data-reveal>
        <a href={projectsPath(locale)} class="btn btn-primary" data-magnetic>
          {t('cta.explore')}
        </a>
        <a href={contactPath(locale)} class="btn btn-ghost">{t('cta.talk')}</a>
      </div>

      <dl class="hero-facts" data-reveal>
        <div>
          <dt>{t('facts.shipped')}</dt>
          <dd>{live}</dd>
        </div>
        <div>
          <dt>{t('facts.areas')}</dt>
          <dd>3</dd>
        </div>
        <div>
          <dt>{t('facts.stack')}</dt>
          <dd>TypeScript</dd>
        </div>
      </dl>
    </div>

    <div class="hero-stack" data-reveal data-scroll-tilt>
      <ul class="stack-list" data-autoplay="5000">
        {
          previews.map((p, i) => (
            <li class:list={['stack-item', { 'is-front': i === 0 }]} style={`--i:${i}`}>
              <a href={projectPath(locale, p.data.slug)} class="stack-card mockup">
                <span class="mockup-bar" aria-hidden="true">
                  <span />
                  <span />
                  <span />
                </span>
                <img
                  src={withBase(p.data.cover)}
                  alt={p.data.coverAlt}
                  width="1280"
                  height="800"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                />
                <span class="stack-info">
                  <span class="stack-cat">{getCategory(p.data.category).label[locale]}</span>
                  <span class="stack-name">{p.data.title}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  /**
   * Rota la pila de proyectos: la tarjeta frontal pasa al fondo y la
   * siguiente toma su sitio. Se pausa al pasar el puntero, al enfocar con
   * teclado y cuando la pestaña no está visible.
   */
  const list = document.querySelector<HTMLElement>('.stack-list[data-autoplay]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (list && !reducedMotion) {
    const items = Array.from(list.querySelectorAll<HTMLElement>('.stack-item'));

    if (items.length > 1) {
      const delay = Number.parseInt(list.dataset.autoplay ?? '5000', 10);
      let front = 0;
      let timer: number | undefined;

      const render = () => {
        items.forEach((item, index) => {
          const depth = (index - front + items.length) % items.length;
          item.style.setProperty('--i', String(depth));
          item.classList.toggle('is-front', depth === 0);
          // Solo la tarjeta visible es navegable con teclado
          item.querySelector('a')?.setAttribute('tabindex', depth === 0 ? '0' : '-1');
        });
      };

      const advance = () => {
        front = (front + 1) % items.length;
        render();
      };

      const start = () => {
        if (timer === undefined) timer = window.setInterval(advance, delay);
      };

      const stop = () => {
        window.clearInterval(timer);
        timer = undefined;
      };

      list.addEventListener('pointerenter', stop);
      list.addEventListener('pointerleave', start);
      list.addEventListener('focusin', stop);
      list.addEventListener('focusout', start);
      document.addEventListener('visibilitychange', () => {
        document.hidden ? stop() : start();
      });

      render();
      start();
    }
  }
</script>

<style>
  .hero {
    position: relative;
    padding-block: clamp(var(--space-7), 7vw, var(--space-9));
    overflow: clip;
  }

  .shape-1 {
    top: 12%;
    right: 6%;
    width: 320px;
    height: 26px;
    rotate: -34deg;
  }

  .shape-2 {
    bottom: 14%;
    left: -60px;
    width: 240px;
    height: 18px;
    rotate: -34deg;
    animation-delay: -6s;
  }

  .hero-inner {
    position: relative;
    z-index: var(--z-raised);
    display: grid;
    gap: clamp(var(--space-6), 5vw, var(--space-8));
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .hero-copy h1 {
    max-width: 14ch;
  }

  .hero-lead {
    max-width: 44ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Datos verificables, no promesas */
  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin: var(--space-3) 0 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    width: 100%;
    max-width: 34rem;
  }

  .hero-facts dt {
    font-size: var(--font-size-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-soft);
  }

  .hero-facts dd {
    margin: var(--space-1) 0 0;
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--text);
  }

  /* --- Pila de proyectos --- */
  .hero-stack {
    display: none;
    perspective: 1400px;
  }

  .stack-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    transform-style: preserve-3d;
    /* El script pone --tilt: 1 arriba y 0 al entrar en pantalla */
    rotate: x calc(var(--tilt, 0) * 16deg);
    transition: rotate var(--duration-slow) var(--ease-standard);
  }

  .stack-item {
    grid-area: 1 / 1;
    translate: calc(var(--i) * 30px) calc(var(--i) * -22px);
    scale: calc(1 - var(--i) * 0.07);
    z-index: calc(10 - var(--i));
    transition:
      translate var(--duration-slow) var(--ease-standard),
      scale var(--duration-slow) var(--ease-standard);
  }

  .stack-card {
    display: block;
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow-lg);
  }

  .stack-card img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .stack-info {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: 2px;
    padding: var(--space-5) var(--space-5) var(--space-4);
    background: linear-gradient(0deg, rgba(4, 5, 11, 0.95), transparent);
    transition: opacity var(--duration-base) var(--ease-standard);
  }

  /* Solo la tarjeta frontal se rotula: las de detrás son profundidad */
  .stack-item:not(.is-front) .stack-info {
    opacity: 0;
  }

  .stack-item:not(.is-front) .stack-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(4, 5, 11, 0.55);
    transition: background-color var(--duration-base) var(--ease-standard);
  }

  .stack-cat {
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  .stack-name {
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--color-white);
  }

  /* Al pasar el puntero la pila se abre en abanico */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .stack-list:hover .stack-item {
      translate: calc(var(--i) * 44px) calc(var(--i) * -34px);
      scale: calc(1 - var(--i) * 0.03);
    }

    .stack-list:hover .stack-item:not(.is-front) .stack-card::after {
      background: rgba(4, 5, 11, 0.3);
    }
  }

  @media (min-width: 980px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
    }

    .hero-stack {
      display: block;
    }
  }
</style>

---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../data/company';
import { useTranslations, projectsPath } from '../../i18n/utils';
import ProjectPreview from '../projects/ProjectPreview.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
  locale: Locale;
}

const { projects, locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="section section-line">
  <div class="container">
    <div class="feed-head" data-reveal>
      <div>
        <p class="eyebrow">{t('feed.eyebrow')}</p>
        <h2>{t('feed.title')}</h2>
      </div>
      <a href={projectsPath(locale)} class="link-editorial">{t('feed.all')}</a>
    </div>

    <div class="feed-grid" data-reveal-group>
      {projects.map((project) => <ProjectPreview project={project} locale={locale} />)}
    </div>
  </div>
</section>

<style>
  .feed-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: clamp(var(--space-5), 4vw, var(--space-7));
  }

  .feed-head .eyebrow {
    margin-bottom: var(--space-2);
  }

  .feed-grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 700px) {
    .feed-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1060px) {
    .feed-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

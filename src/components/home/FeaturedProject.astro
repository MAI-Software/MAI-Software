---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../data/company';
import { getCategory } from '../../data/categories';
import { useTranslations, projectPath } from '../../i18n/utils';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = useTranslations(locale);
const data = project.data;
const category = getCategory(data.category);
const href = projectPath(locale, data.slug);
---

<section class="section section-line featured">
  <div class="container featured-inner">
    <a href={href} class="featured-cover" data-parallax="0.04" tabindex="-1" aria-hidden="true">
      <img src={data.cover} alt={data.coverAlt} width="1280" height="800" loading="lazy" />
      <span class="cover-sheen"></span>
    </a>

    <div class="featured-body" data-reveal-group>
      <p class="eyebrow" data-reveal>{t('featured.label')}</p>

      <div class="featured-meta" data-reveal>
        <span class="badge">{category.label[locale]}</span>
        <span class="badge">{data.year}</span>
        {data.demoUrl && <span class="badge badge-live">{t('projects.live')}</span>}
        {data.example && <span class="badge badge-example">{t('projects.example')}</span>}
      </div>

      <h2 data-reveal>
        <a href={href} class="featured-title">{data.title}</a>
      </h2>

      <p class="lead featured-excerpt" data-reveal>{data.excerpt}</p>

      {
        data.technologies.length > 0 && (
          <ul class="tag-list" data-reveal aria-label={t('projects.tech')}>
            {data.technologies.map((tech) => (
              <li>{tech}</li>
            ))}
          </ul>
        )
      }

      <div class="featured-actions" data-reveal>
        <a href={href} class="btn btn-primary" data-magnetic>{t('cta.viewProject')}</a>
        {
          data.demoUrl && (
            <a href={data.demoUrl} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
              {t('cta.openDemo')} ↗
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .featured-inner {
    display: grid;
    gap: clamp(var(--space-6), 5vw, var(--space-8));
    align-items: center;
  }

  .featured-cover {
    position: relative;
    display: block;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
  }

  .featured-cover img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-standard);
  }

  /* Brillo diagonal que cruza al pasar el puntero */
  .cover-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 42%, rgba(255, 255, 255, 0.16) 50%, transparent 58%);
    translate: -110% 0;
    transition: translate 900ms var(--ease-standard);
    pointer-events: none;
  }

  @media (hover: hover) {
    .featured-cover:hover img {
      transform: scale(1.04);
    }

    .featured-cover:hover .cover-sheen {
      translate: 110% 0;
    }
  }

  .featured-body {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .featured-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .featured-title {
    color: var(--color-white);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-standard);
  }

  .featured-title:hover {
    color: var(--cyan);
  }

  .featured-excerpt {
    max-width: 46ch;
  }

  .featured-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  @media (min-width: 900px) {
    .featured-inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }
</style>

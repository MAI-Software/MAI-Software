---
import type { Locale } from '../../data/company';
import { useTranslations, contactPath } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="section final-cta">
  <div class="container">
    <div class="final-panel panel" data-reveal>
      <span class="final-glow" aria-hidden="true"></span>
      <div class="final-body">
        <h2>{t('final.title')}</h2>
        <a href={contactPath(locale)} class="btn btn-primary" data-magnetic>
          {t('cta.contact')}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .final-panel {
    padding: clamp(var(--space-7), 7vw, var(--space-9)) clamp(var(--space-5), 5vw, var(--space-8));
    border-radius: var(--radius-xl);
    background: linear-gradient(150deg, rgba(98, 66, 252, 0.14), rgba(16, 200, 252, 0.06));
  }

  .final-glow {
    position: absolute;
    top: -40%;
    right: -10%;
    width: 30rem;
    height: 30rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(56, 130, 251, 0.28), transparent 68%);
    pointer-events: none;
  }

  .final-body {
    position: relative;
    z-index: var(--z-raised);
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }

  .final-body h2 {
    max-width: 20ch;
  }
</style>

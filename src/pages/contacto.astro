---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/global/ContactForm.astro';
import LiveLinks from '../components/global/LiveLinks.astro';
import { company } from '../data/company';
import { useTranslations } from '../i18n/utils';

const locale = 'es';
const t = useTranslations(locale);
const hasForm = company.contact.web3formsKey !== '';
---

<BaseLayout
  locale={locale}
  title="Contacto | Cuéntanos tu idea | MAI Software"
  description="¿Tienes una idea entre manos? Cuéntanos qué quieres crear y descubre cómo MAI Software puede ayudarte a convertirla en una experiencia digital real."
  alternatePath="/en/contact"
  hideContactCta
>
  <section class="section contact-page">
    <div class="container">
      <header class="contact-head" data-reveal>
        <span class="brand-rule" aria-hidden="true"></span>
        <h1>{t('contact.title')}</h1>
        <p class="lead">
          No hace falta que esté perfectamente definida. Cuéntanos qué tienes en mente, qué
          quieres mejorar o qué te gustaría crear.
        </p>
      </header>

      <div class="contact-grid">
        <div data-reveal>
          {
            hasForm ? (
              <ContactForm locale={locale} />
            ) : (
              <div class="panel pending-note">
                <p>{t('contact.email.pending')}</p>
                {company.contact.email && (
                  <a href={`mailto:${company.contact.email}`} class="btn btn-primary">
                    {company.contact.email}
                  </a>
                )}
              </div>
            )
          }
        </div>

        <div data-reveal>
          <LiveLinks locale={locale} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-head {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    margin-bottom: clamp(var(--space-6), 5vw, var(--space-8));
  }

  .contact-head h1 {
    font-size: clamp(2.4rem, 5vw, 4rem);
    max-width: 18ch;
  }

  .contact-head .lead {
    max-width: 46ch;
  }

  .contact-grid {
    display: grid;
    gap: clamp(var(--space-6), 5vw, var(--space-8));
    align-items: start;
  }

  .pending-note {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    padding: clamp(var(--space-5), 4vw, var(--space-6));
    color: var(--text-muted);
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }
</style>

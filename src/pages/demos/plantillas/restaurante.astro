---
import DemoLayout from '../../../layouts/DemoLayout.astro';

/* Plantilla de restaurante. El orden no es decorativo: quien entra quiere
   ver qué se come y cuánto cuesta, saber si está abierto y reservar. Por eso
   la carta va entera en la página (nada de PDF) y el botón de reservar
   acompaña todo el recorrido, también en el móvil. */

const menuDia = {
  precio: '16,50',
  incluye: 'Primero, segundo, bebida y postre o café',
  dias: 'De martes a viernes, mediodía',
};

const carta = [
  {
    seccion: 'Para empezar',
    nota: 'Pensados para compartir en el centro de la mesa',
    platos: [
      {
        nombre: 'Pan de masa madre con tomate y anchoa',
        desc: 'Hogaza propia, tomate rallado y anchoa del Cantábrico 00',
        precio: '7,50',
        tags: [],
      },
      {
        nombre: 'Croquetas de puchero',
        desc: 'Seis unidades, bechamel de cocido de la abuela',
        precio: '9,00',
        tags: ['La más pedida'],
      },
      {
        nombre: 'Ensaladilla con langostinos',
        desc: 'Patata de Sanlúcar, mayonesa de la casa y huevas',
        precio: '11,50',
        tags: [],
      },
      {
        nombre: 'Alcachofas confitadas',
        desc: 'Con jamón ibérico y aceite de romero',
        precio: '12,00',
        tags: ['De temporada'],
      },
      {
        nombre: 'Berenjenas con miel de caña',
        desc: 'Fritas al momento, crujientes por fuera',
        precio: '8,50',
        tags: ['Vegetariano'],
      },
    ],
  },
  {
    seccion: 'Del fuego',
    nota: 'Brasa de encina, a la vista desde la sala',
    platos: [
      {
        nombre: 'Arroz meloso de secreto y setas',
        desc: 'Mínimo dos personas, 25 minutos de espera',
        precio: '18,50',
        tags: ['Para dos'],
      },
      {
        nombre: 'Pluma ibérica a la brasa',
        desc: 'Con puré de manzana asada y pimienta de Jamaica',
        precio: '21,00',
        tags: [],
      },
      {
        nombre: 'Lubina al horno de leña',
        desc: 'Verduras de temporada y aceite de cebollino',
        precio: '23,50',
        tags: ['Sin gluten'],
      },
      {
        nombre: 'Costilla glaseada 12 horas',
        desc: 'Cocción lenta, glaseado de Pedro Ximénez',
        precio: '19,00',
        tags: ['La más pedida'],
      },
      {
        nombre: 'Coliflor a la brasa con tahini',
        desc: 'Entera, con granada y hierbabuena',
        precio: '14,00',
        tags: ['Vegano'],
      },
    ],
  },
  {
    seccion: 'Dulces',
    nota: 'Todo hecho aquí, cada mañana',
    platos: [
      {
        nombre: 'Tarta de queso al horno',
        desc: 'Cremosa por dentro, con mermelada de frutos rojos',
        precio: '6,50',
        tags: ['La más pedida'],
      },
      {
        nombre: 'Torrija caramelizada',
        desc: 'De brioche, con helado de vainilla bourbon',
        precio: '7,00',
        tags: [],
      },
      {
        nombre: 'Flan de huevo de corral',
        desc: 'Receta de la casa, con nata montada al momento',
        precio: '5,50',
        tags: [],
      },
    ],
  },
];

const bebidas = [
  { nombre: 'Vino de la casa (copa)', precio: '3,00' },
  { nombre: 'Tinto Ribera del Duero (botella)', precio: '19,00' },
  { nombre: 'Cerveza artesana local', precio: '3,80' },
  { nombre: 'Vermut de grifo', precio: '3,20' },
];

const horarios = [
  { dia: 'Lunes', horas: 'Cerrado', cerrado: true },
  { dia: 'Martes a jueves', horas: '13:00 – 16:00 · 20:00 – 23:30' },
  { dia: 'Viernes y sábado', horas: '13:00 – 16:30 · 20:00 – 00:00' },
  { dia: 'Domingo', horas: '13:00 – 16:30' },
];

const resenas = [
  {
    texto: 'El arroz meloso justifica el viaje. Pedimos mesa un viernes y nos trataron como si fuéramos de la familia.',
    autor: 'Marta G.',
    origen: 'Google',
  },
  {
    texto: 'Carta corta y todo bueno, que es justo lo que busco. La tarta de queso es de las mejores de Sevilla.',
    autor: 'Javier R.',
    origen: 'TripAdvisor',
  },
  {
    texto: 'Fuimos con dos niños y nos resolvieron la cena sin dramas. Volveremos seguro.',
    autor: 'Lucía y Dani',
    origen: 'Google',
  },
];

const galeria = ['La sala', 'La brasa', 'La barra', 'El patio'];
---

<DemoLayout
  title="Casa Molinero · cocina de mercado en Sevilla"
  description="Plantilla de ejemplo: web para restaurante con carta completa, menú del día, horarios, reseñas y reserva de mesa."
>
  <div class="site">
    <header class="top">
      <a class="brand" href="#inicio">
        <span class="brand-mark" aria-hidden="true">CM</span>
        <span class="brand-text">
          Casa Molinero
          <small>Cocina de mercado · Sevilla</small>
        </span>
      </a>
      <nav aria-label="Principal">
        <a href="#carta">Carta</a>
        <a href="#menu-dia">Menú del día</a>
        <a href="#local">El local</a>
        <a href="#resenas">Reseñas</a>
      </nav>
      <div class="top-actions">
        <a class="tel" href="tel:+34955000000">955 000 000</a>
        <a class="btn" href="#reserva">Reservar mesa</a>
      </div>
    </header>

    <section class="hero" id="inicio">
      <div class="hero-text">
        <p class="chip"><span class="dot" aria-hidden="true"></span>Abierto hoy hasta las 23:30</p>
        <h1>Cocina de mercado, brasa de encina y una carta que cambia cada semana.</h1>
        <p class="lead">
          Veinte mesas en una casa de 1912 en pleno centro. Lo que llega del mercado por la
          mañana es lo que se cocina por la noche.
        </p>
        <div class="hero-actions">
          <a class="btn big" href="#reserva">Reservar mesa</a>
          <a class="btn ghost big" href="#carta">Ver la carta</a>
        </div>
        <ul class="hero-facts">
          <li><strong>4,8</strong><span>en 620 reseñas</span></li>
          <li><strong>16,50 €</strong><span>menú del día</span></li>
          <li><strong>12 años</strong><span>en el barrio</span></li>
        </ul>
      </div>

      <div class="hero-art" aria-hidden="true">
        <div class="plate plate-a"><span></span></div>
        <div class="plate plate-b"><span></span></div>
        <div class="plate plate-c"><span></span></div>
        <p class="art-note">Aquí irían tus fotos</p>
      </div>
    </section>

    <section class="menu-dia" id="menu-dia">
      <div class="menu-dia-card">
        <div>
          <p class="eyebrow">Menú del día</p>
          <p class="precio-grande">{menuDia.precio} €</p>
          <p class="menu-incluye">{menuDia.incluye}</p>
          <p class="menu-dias">{menuDia.dias}</p>
        </div>
        <ul class="menu-dia-lista">
          <li><strong>Primeros</strong> Crema del día · Ensalada de la huerta · Puchero</li>
          <li><strong>Segundos</strong> Pescado del día · Pollo de corral · Guiso de temporada</li>
          <li><strong>Postres</strong> Tarta de queso · Fruta · Café con dulce</li>
        </ul>
        <a class="btn" href="#reserva">Reservar para el mediodía</a>
      </div>
    </section>

    <section class="carta" id="carta">
      <header class="sec-head">
        <div>
          <p class="eyebrow">La carta</p>
          <h2>Lo que hay hoy en la pizarra</h2>
        </div>
        <p class="sec-note">
          Cambia cada semana según el mercado. Carta de alérgenos disponible en sala.
        </p>
      </header>

      {
        carta.map((bloque) => (
          <div class="carta-bloque">
            <div class="carta-titulo">
              <h3>{bloque.seccion}</h3>
              <p>{bloque.nota}</p>
            </div>
            <ul class="platos">
              {bloque.platos.map((plato) => (
                <li class="plato">
                  <span class="plato-foto" aria-hidden="true" />
                  <span class="plato-cuerpo">
                    <span class="plato-linea">
                      <span class="plato-nombre">{plato.nombre}</span>
                      <span class="plato-precio">{plato.precio} €</span>
                    </span>
                    <span class="plato-desc">{plato.desc}</span>
                    {plato.tags.length > 0 && (
                      <span class="plato-tags">
                        {plato.tags.map((tag) => (
                          <span class="tag">{tag}</span>
                        ))}
                      </span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="bebidas">
        <h3>Para beber</h3>
        <ul>
          {
            bebidas.map((b) => (
              <li>
                <span>{b.nombre}</span>
                <span class="plato-precio">{b.precio} €</span>
              </li>
            ))
          }
        </ul>
        <p class="bodega">Bodega de 40 referencias, la mitad de vinos andaluces.</p>
      </div>
    </section>

    <section class="galeria" aria-label="El local en imágenes">
      {
        galeria.map((titulo, i) => (
          <figure class={`shot shot-${i + 1}`}>
            <figcaption>{titulo}</figcaption>
          </figure>
        ))
      }
    </section>

    <section class="local" id="local">
      <div class="local-texto">
        <p class="eyebrow">El local</p>
        <h2>Una casa de 1912 con la cocina a la vista</h2>
        <p>
          Veinte mesas, barra para comer sin reserva y un patio interior con seis mesas más
          cuando acompaña el tiempo. Accesible desde la calle y con trona para los peques.
        </p>
        <ul class="servicios">
          <li>Terraza en el patio</li>
          <li>Accesible</li>
          <li>Opciones veganas</li>
          <li>Sin gluten bajo aviso</li>
          <li>Grupos hasta 24</li>
        </ul>
        <p class="direccion">
          <strong>Calle del Horno 14, Sevilla</strong><br />
          A cinco minutos andando de la catedral · Parking Arenal a 200 m
        </p>
      </div>

      <div class="local-aside">
        <div class="mapa" aria-hidden="true">
          <span class="pin"></span>
          <span class="calle calle-1"></span>
          <span class="calle calle-2"></span>
          <span class="calle calle-3"></span>
        </div>
        <div class="horario">
          <h3>Horarios</h3>
          <ul>
            {
              horarios.map((h) => (
                <li class:list={{ cerrado: h.cerrado }}>
                  <span>{h.dia}</span>
                  <span>{h.horas}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="resenas" id="resenas">
      <header class="sec-head">
        <div>
          <p class="eyebrow">Reseñas</p>
          <h2>Lo que dicen quienes ya han venido</h2>
        </div>
        <p class="sec-note">4,8 sobre 5 · 620 reseñas entre Google y TripAdvisor</p>
      </header>
      <div class="resenas-grid">
        {
          resenas.map((r) => (
            <blockquote>
              <p class="estrellas" aria-label="5 sobre 5">★★★★★</p>
              <p>{r.texto}</p>
              <footer>
                {r.autor} · {r.origen}
              </footer>
            </blockquote>
          ))
        }
      </div>
    </section>

    <section class="reserva" id="reserva">
      <div class="reserva-grid">
        <div>
          <p class="eyebrow claro">Reservar</p>
          <h2>Mesa para hoy o para el sábado</h2>
          <p class="reserva-texto">
            Confirmamos por teléfono en menos de una hora dentro del horario de cocina. Para
            grupos de más de ocho, mejor llámanos directamente.
          </p>
          <a class="tel-grande" href="tel:+34955000000">955 000 000</a>
        </div>

        <form>
          <label>
            Nombre
            <input type="text" placeholder="A nombre de" required />
          </label>
          <label>
            Teléfono
            <input type="tel" placeholder="600 000 000" required />
          </label>
          <label>
            Día
            <input type="date" />
          </label>
          <label>
            Hora
            <select>
              <option>13:30</option>
              <option>14:00</option>
              <option>14:30</option>
              <option>21:00</option>
              <option selected>21:30</option>
              <option>22:00</option>
            </select>
          </label>
          <label>
            Personas
            <select>
              <option>1</option>
              <option selected>2</option>
              <option>3</option>
              <option>4</option>
              <option>5</option>
              <option>6</option>
              <option>Más de 6</option>
            </select>
          </label>
          <label class="ancho">
            Algo que debamos saber
            <input type="text" placeholder="Alergias, trona, celebración…" />
          </label>
          <button type="button">Pedir reserva</button>
          <p class="form-nota">Te llamamos para confirmar. Sin pago por adelantado.</p>
        </form>
      </div>
    </section>

    <footer class="foot">
      <div>
        <p class="foot-brand">Casa Molinero</p>
        <p>Calle del Horno 14, Sevilla · 955 000 000 · hola@casamolinero.es</p>
      </div>
      <p class="mini">Plantilla de ejemplo. Nombres, precios y reseñas son ficticios.</p>
    </footer>

    <!-- Barra fija en móvil: reservar nunca queda a más de un toque -->
    <div class="barra-movil">
      <a class="btn ghost" href="tel:+34955000000">Llamar</a>
      <a class="btn" href="#reserva">Reservar mesa</a>
    </div>
  </div>
</DemoLayout>

<style>
  .site {
    --tinta: #241a13;
    --papel: #fbf6ee;
    --papel-2: #f4ebdd;
    --acento: #b4451f;
    --acento-2: #d98032;
    --verde: #4a6741;
    --suave: #7d6a5b;
    --linea: rgba(36, 26, 19, 0.14);

    background: var(--papel);
    color: var(--tinta);
    font-family: 'Iowan Old Style', Georgia, 'Times New Roman', serif;
    padding-bottom: 5.5rem;
  }

  /* --- Cabecera --- */
  .top {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.85rem clamp(1.1rem, 4vw, 3.5rem);
    background: rgba(251, 246, 238, 0.94);
    border-bottom: 1px solid var(--linea);
    backdrop-filter: blur(10px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--acento);
    color: var(--papel);
    font-size: 0.95rem;
    letter-spacing: 0.04em;
  }

  .brand-text {
    display: grid;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .brand-text small {
    font-family: system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--suave);
  }

  .top nav {
    display: none;
    gap: 1.6rem;
    font-size: 0.98rem;
  }

  .top nav a {
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
  }

  .top nav a:hover {
    color: var(--acento);
    border-bottom-color: var(--acento);
  }

  .top-actions {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .tel {
    display: none;
    font-family: system-ui, sans-serif;
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--suave);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 1.3rem;
    border-radius: 999px;
    background: var(--acento);
    color: var(--papel);
    font-family: system-ui, sans-serif;
    font-size: 0.94rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
    background: #9c3a19;
  }

  .btn.ghost {
    background: transparent;
    border: 1px solid var(--linea);
    color: var(--tinta);
  }

  .btn.ghost:hover {
    background: rgba(36, 26, 19, 0.06);
  }

  .btn.big {
    min-height: 54px;
    padding: 0 1.9rem;
    font-size: 1rem;
  }

  /* --- Portada --- */
  .hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.1rem, 4vw, 3.5rem);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.2rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: rgba(74, 103, 65, 0.12);
    color: var(--verde);
    font-family: system-ui, sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--verde);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.1rem, 4.6vw, 3.6rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    max-width: 16ch;
  }

  .lead {
    max-width: 46ch;
    color: var(--suave);
    font-size: 1.08rem;
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1.8rem;
    margin: 2.2rem 0 0;
    padding: 1.4rem 0 0;
    border-top: 1px solid var(--linea);
    list-style: none;
  }

  .hero-facts li {
    display: grid;
    gap: 0.15rem;
  }

  .hero-facts strong {
    font-size: 1.5rem;
    color: var(--acento);
  }

  .hero-facts span {
    font-family: system-ui, sans-serif;
    font-size: 0.84rem;
    color: var(--suave);
  }

  /* Bodegón de platos: hasta que lleguen fotos reales, esto sugiere mesa */
  .hero-art {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3.4;
    border-radius: 22px;
    background:
      radial-gradient(80% 70% at 70% 20%, rgba(255, 255, 255, 0.35), transparent 60%),
      linear-gradient(150deg, #e8cfae 0%, #c99a63 55%, #8d5f34 100%);
    overflow: hidden;
  }

  .plate {
    position: absolute;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 32%, #fff 0%, #f3e8d6 55%, #dcc7a6 100%);
    box-shadow: 0 22px 44px rgba(60, 35, 12, 0.32);
  }

  .plate span {
    border-radius: 50%;
  }

  .plate-a {
    width: 54%;
    aspect-ratio: 1;
    top: 12%;
    left: 8%;
  }

  .plate-a span {
    width: 62%;
    aspect-ratio: 1;
    background: radial-gradient(circle at 40% 35%, #d8a34e, #a8641f 70%, #7c4413);
  }

  .plate-b {
    width: 40%;
    aspect-ratio: 1;
    right: 7%;
    top: 26%;
  }

  .plate-b span {
    width: 60%;
    aspect-ratio: 1;
    background: radial-gradient(circle at 45% 40%, #7fa25f, #48622f);
  }

  .plate-c {
    width: 34%;
    aspect-ratio: 1;
    bottom: 8%;
    left: 34%;
  }

  .plate-c span {
    width: 58%;
    aspect-ratio: 1;
    background: radial-gradient(circle at 42% 38%, #f0e0c2, #c9a06a);
  }

  .art-note {
    position: absolute;
    right: 0.9rem;
    bottom: 0.7rem;
    margin: 0;
    font-family: system-ui, sans-serif;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.85);
  }

  /* --- Menú del día --- */
  .menu-dia {
    padding: 0 clamp(1.1rem, 4vw, 3.5rem);
  }

  .menu-dia-card {
    display: grid;
    gap: 1.6rem;
    align-items: center;
    padding: clamp(1.6rem, 4vw, 2.6rem);
    border-radius: 22px;
    background: linear-gradient(120deg, var(--acento) 0%, var(--acento-2) 100%);
    color: var(--papel);
  }

  .menu-dia-card .eyebrow {
    color: rgba(255, 255, 255, 0.85);
  }

  .precio-grande {
    margin: 0.2rem 0 0.4rem;
    font-size: clamp(2.6rem, 6vw, 3.6rem);
    line-height: 1;
  }

  .menu-incluye {
    margin: 0;
    font-size: 1.02rem;
  }

  .menu-dias {
    margin: 0.4rem 0 0;
    font-family: system-ui, sans-serif;
    font-size: 0.86rem;
    color: rgba(255, 255, 255, 0.82);
  }

  .menu-dia-lista {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.98rem;
  }

  .menu-dia-lista li {
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
  }

  .menu-dia-lista strong {
    display: block;
    font-family: system-ui, sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
  }

  .menu-dia-card .btn {
    background: var(--papel);
    color: var(--acento);
    justify-self: start;
  }

  .menu-dia-card .btn:hover {
    background: #fff;
  }

  /* --- Carta --- */
  section {
    padding: clamp(2.6rem, 6vw, 4.5rem) clamp(1.1rem, 4vw, 3.5rem);

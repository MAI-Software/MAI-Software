---
import '@fontsource-variable/ibm-plex-sans';
import DemoLayout from '../../../layouts/DemoLayout.astro';

/* Plantilla de centro de masaje. En este sector la web se cae por dos
   motivos: no se ve el precio y no se sabe pedir cita. Aquí las tarifas van
   completas y el botón de cita acompaña todo el recorrido. */

const tratamientos = [
  {
    nombre: 'Descontracturante',
    duracion: '50 min',
    precio: '45 €',
    texto: 'Para la espalda cargada de oficina, entrenamiento o malas posturas.',
    para: 'Cervicales, trapecios y lumbares',
    icono: 'espalda',
  },
  {
    nombre: 'Deportivo',
    duracion: '60 min',
    precio: '55 €',
    texto: 'Antes o después de competir, y en recuperación de sobrecargas.',
    para: 'Gemelos, isquios y cuádriceps',
    icono: 'pierna',
  },
  {
    nombre: 'Drenaje linfático',
    duracion: '60 min',
    precio: '50 €',
    texto: 'Presión suave y rítmica para activar el sistema linfático.',
    para: 'Piernas pesadas y postoperatorio',
    icono: 'gota',
  },
  {
    nombre: 'Relajante completo',
    duracion: '75 min',
    precio: '60 €',
    texto: 'Cuerpo entero, luz baja y ningún reloj a la vista.',
    para: 'Estrés, insomnio y tensión general',
    icono: 'luna',
  },
  {
    nombre: 'Craneal y facial',
    duracion: '40 min',
    precio: '38 €',
    texto: 'Cabeza, cuello y mandíbula. Para quien aprieta los dientes.',
    para: 'Dolor de cabeza y bruxismo',
    icono: 'cabeza',
  },
  {
    nombre: 'Embarazo',
    duracion: '50 min',
    precio: '48 €',
    texto: 'Postura lateral con cojines, a partir del segundo trimestre.',
    para: 'Lumbares y piernas',
    icono: 'corazon',
  },
];

const bonos = [
  {
    nombre: 'Primera visita',
    precio: '35 €',
    nota: 'Valoración incluida, 50 minutos',
    detalle: ['Entrevista y exploración', 'Sesión completa', 'Pautas para casa'],
  },
  {
    nombre: 'Bono 5 sesiones',
    precio: '200 €',
    nota: 'Ahorras 25 € · sin caducidad',
    detalle: ['Cualquier tratamiento', 'Transferible', 'Pago en dos veces'],
    destacado: true,
  },
  {
    nombre: 'Bono 10 sesiones',
    precio: '380 €',
    nota: 'Ahorras 70 € · compartible',
    detalle: ['Cualquier tratamiento', 'Compartible en pareja', 'Cita preferente'],
  },
];

const pasos = [
  { t: 'Nos cuentas', d: 'Qué te duele, desde cuándo y qué has probado ya.' },
  { t: 'Valoramos', d: 'Exploramos la zona y decidimos el tratamiento contigo.' },
  { t: 'Tratamos', d: 'La sesión, a tu ritmo de presión, sin sorpresas.' },
  { t: 'Te vas con deberes', d: 'Dos o tres ejercicios para casa. Sin venderte un bono.' },
];

const equipo = [
  { n: 'Lucía Marín', r: 'Fisioterapeuta · col. 12345', e: '12 años · deportivo y terapéutico' },
  { n: 'Diego Ruiz', r: 'Fisioterapeuta · col. 12346', e: '8 años · drenaje y embarazo' },
  { n: 'Ana Belén Costa', r: 'Masajista · dipl. 4417', e: '6 años · relajante y craneal' },
];

const resenas = [
  { t: 'Llevaba meses con la cervical y en tres sesiones estaba nueva. Y me dijeron que no hacía falta una cuarta.', a: 'Carmen P.' },
  { t: 'Voy cada quince días desde hace dos años. Nunca me han vendido nada que no necesitara.', a: 'Fran M.' },
  { t: 'El trato es de otra época, en el buen sentido. Salgo del centro como nueva.', a: 'Isabel R.' },
];

const preguntas = [
  { q: '¿Cuántas sesiones voy a necesitar?', a: 'Depende de lo que traigas, pero en la primera visita te damos una estimación honesta. Muchas contracturas se resuelven en dos o tres sesiones.' },
  { q: '¿Tengo que llevar algo?', a: 'Nada. Ponemos toallas, sábanas y todo lo necesario. Si vienes de entrenar, hay ducha.' },
  { q: '¿Duele el masaje descontracturante?', a: 'Puede molestar en el punto exacto de la contractura, pero se trabaja a tu tolerancia. Si duele de más, se baja la presión.' },
  { q: '¿Se puede pagar con tarjeta?', a: 'Sí, tarjeta, Bizum y efectivo. Los bonos se pueden fraccionar en dos pagos.' },
];
---

<DemoLayout
  title="Centro Sereno · masaje y fisioterapia en Granada"
  description="Plantilla de ejemplo: web para centro de masajes con tratamientos, precios, bonos, equipo y cita."
>
  <div class="site">
    <header class="top">
      <a class="brand" href="#inicio">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-text">
          Centro Sereno
          <small>Masaje y fisioterapia · Granada</small>
        </span>
      </a>
      <nav aria-label="Principal">
        <a href="#tratamientos">Tratamientos</a>
        <a href="#precios">Precios</a>
        <a href="#equipo">Equipo</a>
        <a href="#preguntas">Preguntas</a>
      </nav>
      <a class="btn" href="#cita">Pedir cita</a>
    </header>

    <section class="hero" id="inicio">
      <div class="hero-text">
        <p class="chip"><span class="dot" aria-hidden="true"></span>Hay hueco esta semana</p>
        <h1>Media hora para ti. El resto del día lo notas.</h1>
        <p class="lead">
          Sesiones de uno en uno, sin prisa y sin música de ascensor. Te decimos cuántas
          sesiones necesitas de verdad, aunque sean menos de las que esperabas.
        </p>
        <div class="hero-actions">
          <a class="btn big" href="#cita">Pedir cita</a>
          <a class="btn ghost big" href="#precios">Ver precios</a>
        </div>
        <ul class="badges">
          <li>Fisioterapeutas colegiados</li>
          <li>Sábados por la mañana</li>
          <li>Parking en la puerta</li>
          <li>Primera visita 35 €</li>
        </ul>
      </div>
      <div class="hero-art" aria-hidden="true">
        <span class="onda onda-1"></span>
        <span class="onda onda-2"></span>
        <span class="onda onda-3"></span>
        <span class="piedra piedra-1"></span>
        <span class="piedra piedra-2"></span>
        <span class="piedra piedra-3"></span>
        <p class="art-note">Aquí irían tus fotos</p>
      </div>
    </section>

    <section class="tratamientos" id="tratamientos">
      <header class="sec-head">
        <div>
          <p class="eyebrow">Tratamientos</p>
          <h2>Cada uno con su duración y su precio</h2>
        </div>
        <p class="sec-note">Precios finales con IVA. Sin cuotas, sin permanencia y sin letra pequeña.</p>
      </header>

      <div class="grid">
        {
          tratamientos.map((t) => (
            <article class="card">
              <span class={`icono icono-${t.icono}`} aria-hidden="true" />
              <div class="card-head">
                <h3>{t.nombre}</h3>
                <p class="precio">
                  {t.precio} <span>{t.duracion}</span>
                </p>
              </div>
              <p class="card-texto">{t.texto}</p>
              <p class="card-para">{t.para}</p>
              <a class="card-cta" href="#cita">
                Reservar <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="precios" id="precios">
      <header class="sec-head">
        <div>
          <p class="eyebrow">Bonos</p>
          <h2>Sale más barato si vienes seguido</h2>
        </div>
        <p class="sec-note">Los bonos valen para cualquier tratamiento y no caducan.</p>
      </header>

      <div class="bonos">
        {
          bonos.map((b) => (
            <div class:list={['bono', { destacado: b.destacado }]}>
              {b.destacado && <span class="etiqueta">El más elegido</span>}
              <p class="bono-nombre">{b.nombre}</p>
              <p class="bono-precio">{b.precio}</p>
              <p class="bono-nota">{b.nota}</p>
              <ul>
                {b.detalle.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
              <a class="btn ghost" href="#cita">
                Quiero este
              </a>
            </div>
          ))
        }
      </div>
    </section>

    <section class="proceso">
      <header class="sec-head">
        <div>
          <p class="eyebrow">Cómo trabajamos</p>
          <h2>Cuatro pasos y ninguna sorpresa</h2>
        </div>
      </header>
      <ol class="pasos">
        {
          pasos.map((p, i) => (
            <li>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <strong>{p.t}</strong>
              <span>{p.d}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="equipo" id="equipo">
      <header class="sec-head">
        <div>
          <p class="eyebrow">Equipo</p>
          <h2>Quién te va a tratar</h2>
        </div>
        <p class="sec-note">Todos con número de colegiado, porque en salud eso importa.</p>
      </header>
      <div class="personas">
        {
          equipo.map((p) => (
            <div class="persona">
              <span class="retrato" aria-hidden="true">
                {p.n
                  .split(' ')
                  .slice(0, 2)
                  .map((w) => w[0])
                  .join('')}
              </span>
              <strong>{p.n}</strong>
              <span class="rol">{p.r}</span>
              <span class="exp">{p.e}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="resenas">
      <div class="resenas-grid">
        {
          resenas.map((r) => (
            <blockquote>
              <p class="estrellas" aria-label="5 sobre 5">
                ★★★★★
              </p>
              <p>{r.t}</p>
              <footer>{r.a}</footer>
            </blockquote>
          ))
        }
      </div>
    </section>

    <section class="preguntas" id="preguntas">
      <header class="sec-head">
        <div>
          <p class="eyebrow">Preguntas frecuentes</p>
          <h2>Lo que más nos preguntáis</h2>
        </div>
      </header>
      <div class="faq">
        {
          preguntas.map((p, i) => (
            <details open={i === 0}>
              <summary>{p.q}</summary>
              <p>{p.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="cita" id="cita">
      <div class="cita-grid">
        <div>
          <p class="eyebrow claro">Pedir cita</p>
          <h2>Contesta la misma persona que te atiende</h2>
          <p class="cita-texto">
            Normalmente el mismo día. Si prefieres hablarlo antes, llámanos y te decimos si tu
            caso es para nosotros o para otro profesional.
          </p>
          <div class="contacto-directo">
            <a href="tel:+34958000000">958 000 000</a>
            <a href="#cita">WhatsApp 600 000 000</a>
          </div>
          <div class="donde">
            <p><strong>Calle Recogidas 8, Granada</strong></p>
            <p>Lunes a viernes 9:00 – 21:00 · Sábados 9:00 – 14:00</p>
          </div>
        </div>

        <form>
          <label>
            Nombre
            <input type="text" placeholder="Tu nombre" required />
          </label>
          <label>
            Teléfono
            <input type="tel" placeholder="600 000 000" required />
          </label>
          <label class="ancho">
            Tratamiento
            <select>
              {tratamientos.map((t) => <option>{`${t.nombre} · ${t.duracion} · ${t.precio}`}</option>)}
              <option>No lo sé, quiero que me asesoréis</option>
            </select>
          </label>
          <label class="ancho">
            Cuándo te viene bien
            <span class="chips">
              <span>Mañanas</span>
              <span>Mediodía</span>
              <span>Tardes</span>
              <span>Sábado</span>
            </span>
          </label>
          <label class="ancho">
            Qué te pasa
            <textarea rows="3" placeholder="Zona, desde cuándo y si viene de algún golpe"></textarea>
          </label>
          <button type="button">Pedir cita</button>
          <p class="form-nota">Te escribimos para confirmar hora. Sin pago por adelantado.</p>
        </form>
      </div>
    </section>

    <footer class="foot">
      <div>
        <p class="foot-brand">Centro Sereno</p>
        <p>Calle Recogidas 8, Granada · 958 000 000 · hola@centrosereno.es</p>
      </div>
      <p class="mini">Plantilla de ejemplo. Nombres, precios y reseñas son ficticios.</p>
    </footer>

    <div class="barra-movil">
      <a class="btn ghost" href="tel:+34958000000">Llamar</a>
      <a class="btn" href="#cita">Pedir cita</a>
    </div>
  </div>
</DemoLayout>

<style>
  .site {
    --verde: #2f5d43;
    --verde-claro: #6f9c76;
    --verde-suave: #dfe9e0;
    --crema: #f7f5f0;
    --crema-2: #ece7dd;
    --tinta: #1d241f;
    --suave: #5d6b60;
    --linea: rgba(29, 36, 31, 0.12);

    background: var(--crema);
    color: var(--tinta);
    font-family: 'IBM Plex Sans Variable', system-ui, sans-serif;
    padding-bottom: 5.5rem;
  }

  .top {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.85rem clamp(1.1rem, 4vw, 3.5rem);
    background: rgba(247, 245, 240, 0.95);
    border-bottom: 1px solid var(--linea);
    backdrop-filter: blur(10px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
  }

  .brand-mark {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #a7c6a9, var(--verde));
  }

  .brand-text {
    display: grid;
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.15;
  }

  .brand-text small {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--suave);
  }

  .top nav {
    display: none;
    gap: 1.5rem;
    font-size: 0.93rem;
  }

  .top nav a {
    color: var(--suave);
    text-decoration: none;
  }

  .top nav a:hover {
    color: var(--verde);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 1.3rem;
    border-radius: 999px;
    background: var(--verde);
    color: var(--crema);
    font-size: 0.94rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
    background: #244b35;
  }

  .btn.ghost {
    background: transparent;
    border: 1px solid var(--linea);
    color: var(--tinta);
  }

  .btn.big {
    min-height: 54px;
    padding: 0 1.9rem;
    font-size: 1rem;
  }

  section {
    padding: clamp(2.6rem, 6vw, 4.5rem) clamp(1.1rem, 4vw, 3.5rem);
  }

  .hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.2rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: var(--verde-suave);
    color: var(--verde);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--verde-claro);
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 3.3rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    max-width: 17ch;
  }

  .lead {
    max-width: 50ch;
    color: var(--suave);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .badges li {
    padding: 0.42rem 0.9rem;
    border: 1px solid var(--linea);
    border-radius: 999px;
    font-size: 0.82rem;
    color: var(--suave);
  }

  .hero-art {
    position: relative;
    aspect-ratio: 4 / 3.6;
    border-radius: 24px;
    overflow: hidden;
    background: linear-gradient(160deg, #cfdfd0 0%, #92b193 45%, #4f7a5b 100%);
  }

  .onda {
    position: absolute;
    left: -20%;
    width: 140%;
    height: 40%;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
  }

  .onda-1 {
    top: 8%;
  }
  .onda-2 {
    top: 38%;
    background: rgba(255, 255, 255, 0.12);
  }
  .onda-3 {
    top: 66%;
    background: rgba(255, 255, 255, 0.09);
  }

  .piedra {
    position: absolute;
    left: 50%;
    border-radius: 50%;
    background: linear-gradient(160deg, #6a6f63, #3c4238);
    box-shadow: 0 10px 22px rgba(20, 28, 20, 0.35);
  }

  .piedra-1 {
    width: 26%;
    aspect-ratio: 2.4;
    bottom: 26%;
    translate: -50% 0;
  }

  .piedra-2 {
    width: 21%;
    aspect-ratio: 2.4;
    bottom: 34%;
    translate: -50% 0;
  }

  .piedra-3 {
    width: 15%;
    aspect-ratio: 2.4;
    bottom: 41%;
    translate: -50% 0;
  }

  .art-note {
    position: absolute;
    right: 0.9rem;
    bottom: 0.7rem;
    margin: 0;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .eyebrow {
    margin: 0;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--verde-claro);
  }

  .eyebrow.claro {
    color: rgba(247, 245, 240, 0.75);
  }

  .sec-head {
    display: grid;
    gap: 0.7rem;
    margin-bottom: 2.2rem;
  }

  h2 {
    margin: 0.3rem 0 0;
    font-size: clamp(1.6rem, 3.4vw, 2.3rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    max-width: 22ch;
  }

  .sec-note {
    margin: 0;
    max-width: 48ch;
    font-size: 0.92rem;
    color: var(--suave);
  }

  .grid {
    display: grid;
    gap: 1rem;
  }

  .card {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    padding: 1.5rem;
    border: 1px solid var(--linea);
    border-radius: 18px;
    background: #fff;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 34px rgba(29, 36, 31, 0.1);
  }

  /* Iconos dibujados en CSS: sin librerías ni peticiones extra */
  .icono {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--verde-suave);
  }

  .icono::before,
  .icono::after {
    content: '';
    position: absolute;
    background: var(--verde);
  }

  .icono-espalda::before {
    inset: 28% 46% 28% 46%;
    border-radius: 4px;
  }
  .icono-espalda::after {
    inset: 38% 28% 38% 28%;
    height: 24%;
    border-radius: 4px;
  }

  .icono-pierna::before {
    inset: 22% 52% 46% 34%;
    border-radius: 6px;
  }
  .icono-pierna::after {
    inset: 54% 34% 22% 46%;
    border-radius: 6px;
  }

  .icono-gota::before {
    inset: 24% 34% 26% 34%;
    border-radius: 50% 50% 50% 50% / 62% 62% 38% 38%;
  }
  .icono-gota::after {
    display: none;
  }

  .icono-luna::before {
    inset: 24%;
    border-radius: 50%;
  }
  .icono-luna::after {
    inset: 18% 22% 30% 38%;
    border-radius: 50%;
    background: var(--verde-suave);
  }

  .icono-cabeza::before {
    inset: 22% 30% 40% 30%;
    border-radius: 50% 50% 40% 40%;
  }
  .icono-cabeza::after {
    inset: 62% 38% 22% 38%;
    border-radius: 3px;
  }

  .icono-corazon::before,
  .icono-corazon::after {
    width: 30%;
    height: 44%;
    border-radius: 50% 50% 0 0;
  }
  .icono-corazon::before {
    left: 22%;
    top: 26%;
    rotate: -45deg;
  }
  .icono-corazon::after {
    right: 22%;
    top: 26%;
    rotate: 45deg;
  }

  .card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .card h3 {
    margin: 0;
    font-size: 1.12rem;
  }

  .precio {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--verde);
    white-space: nowrap;
  }

  .precio span {
    display: block;
    font-size: 0.76rem;
    font-weight: 500;
    color: var(--suave);
    text-align: right;
  }

  .card-texto {
    margin: 0;
    color: var(--suave);
    line-height: 1.6;
  }

  .card-para {
    margin: 0;
    padding: 0.35rem 0.7rem;
    justify-self: start;
    border-radius: 999px;
    background: var(--crema-2);
    font-size: 0.78rem;

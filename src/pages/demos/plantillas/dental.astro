---
import DemoLayout from '../../../layouts/DemoLayout.astro';

/* Plantilla de clínica dental. Aquí lo que vende es la confianza: nombres y
   números de colegiado, precios y financiación por escrito, y una primera
   visita fácil de pedir. Ninguna promesa médica. */

const tratamientos = [
  {
    nombre: 'Revisión y limpieza',
    texto: 'Exploración completa, radiografía si hace falta y limpieza con ultrasonidos.',
    desde: '39 €',
    dura: '45 min',
    icono: 'diente',
  },
  {
    nombre: 'Ortodoncia invisible',
    texto: 'Estudio 3D, plan completo y férulas. Revisión cada seis semanas.',
    desde: '2.400 €',
    dura: '12-18 meses',
    icono: 'alineador',
  },
  {
    nombre: 'Implantes',
    texto: 'Implante de titanio, pilar y corona. Garantía por escrito de diez años.',
    desde: '850 €',
    dura: '2 visitas',
    icono: 'implante',
  },
  {
    nombre: 'Estética dental',
    texto: 'Blanqueamiento en clínica o carillas, con prueba previa en tu boca.',
    desde: '290 €',
    dura: '1-3 visitas',
    icono: 'brillo',
  },
  {
    nombre: 'Odontopediatría',
    texto: 'Primera visita a los tres años, sin prisa y con la familia dentro.',
    desde: '35 €',
    dura: '30 min',
    icono: 'nino',
  },
  {
    nombre: 'Urgencias',
    texto: 'Dolor agudo, fractura o flemón. Hueco reservado cada día.',
    desde: '45 €',
    dura: 'Mismo día',
    icono: 'urgencia',
  },
];

const equipo = [
  {
    nombre: 'Dra. Elena Sarabia',
    rol: 'Directora clínica · Odontología general',
    num: 'col. 28001234',
    extra: 'Universidad Complutense · 18 años',
  },
  {
    nombre: 'Dr. Iván Prats',
    rol: 'Cirugía e implantes',
    num: 'col. 28005678',
    extra: 'Máster en implantología · 11 años',
  },
  {
    nombre: 'Marta Liébana',
    rol: 'Higienista dental',
    num: 'col. 28009012',
    extra: 'Especialista en periodoncia · 9 años',
  },
];

const seguros = ['Adeslas', 'Sanitas', 'DKV', 'Asisa', 'Mapfre', 'Caser'];

const pasos = [
  { t: 'Primera visita gratis', d: 'Exploración, radiografía panorámica y fotos intraorales.' },
  { t: 'Presupuesto cerrado', d: 'Por escrito, con cada tratamiento y su precio. Te lo llevas a casa.' },
  { t: 'Decides tú', d: 'Te decimos qué es urgente, qué puede esperar y qué no hace falta.' },
  { t: 'Tratamiento y revisión', d: 'Con revisión incluida a los seis meses.' },
];

const resenas = [
  { t: 'Me dijeron que dos de los tres empastes que me habían mandado en otro sitio no hacían falta. Ahí se ganaron un paciente.', a: 'Rocío T.', f: 'hace 2 semanas' },
  { t: 'Vine de urgencia un martes a las nueve y a las once estaba resuelto. Trato de diez.', a: 'Andrés M.', f: 'hace 1 mes' },
  { t: 'Llevo con la ortodoncia ocho meses y me han explicado cada paso. Precio cerrado desde el principio.', a: 'Nuria B.', f: 'hace 3 meses' },
];

const casos = [
  { titulo: 'Ortodoncia invisible', detalle: 'Mujer, 29 años · 14 meses de tratamiento' },
  { titulo: 'Rehabilitación con implantes', detalle: 'Hombre, 58 años · 2 implantes y corona' },
  { titulo: 'Blanqueamiento y carillas', detalle: 'Mujer, 41 años · 3 visitas' },
];

const tecnologia = [
  { nombre: 'Escáner intraoral 3D', nota: 'Sin pasta de moldes' },
  { nombre: 'Radiografía digital', nota: 'Hasta 80 % menos de radiación' },
  { nombre: 'Cirugía guiada por ordenador', nota: 'Implantes con férula planificada' },
  { nombre: 'Esterilización clase B', nota: 'Trazabilidad por lote y paciente' },
];

const garantias = [
  { t: 'Diez años en implantes', d: 'Por escrito, con revisiones anuales incluidas en la garantía.' },
  { t: 'Presupuesto cerrado', d: 'El precio firmado es el que se paga, aunque el tratamiento se alargue.' },
  { t: 'Revisión a los seis meses', d: 'Incluida en cualquier tratamiento, sin coste.' },
];

const preguntas = [
  { q: '¿La primera visita tiene coste?', a: 'No. Incluye exploración, radiografía panorámica y presupuesto cerrado por escrito. Sin compromiso de quedarte.' },
  { q: '¿Se puede financiar?', a: 'Sí: hasta 12 meses sin intereses con la clínica, y a más plazo con financiera. Se firma antes de empezar, con el cuadro de cuotas delante.' },
  { q: '¿Atendéis urgencias?', a: 'Reservamos huecos cada día para dolor agudo. Llama por la mañana y te damos hora ese mismo día.' },
  { q: '¿Trabajáis con mi seguro?', a: 'Trabajamos con las principales aseguradoras. Dinos cuál tienes y te confirmamos coberturas antes de la cita.' },
  { q: '¿Y si me da miedo el dentista?', a: 'Nos lo dices al pedir cita y reservamos más tiempo. Se puede empezar solo con una revisión sin tocar nada.' },
];
---

<DemoLayout
  title="Clínica Dental Aranda · odontología en Madrid"
  description="Plantilla de ejemplo: web para clínica dental con tratamientos, precios, equipo, seguros, financiación y primera visita."
>
  <div class="site">
    <header class="top">
      <a class="brand" href="#inicio">
        <span class="mark" aria-hidden="true"></span>
        <span class="brand-text">
          Clínica Aranda
          <small>Odontología · Madrid</small>
        </span>
      </a>
      <nav aria-label="Principal">
        <a href="#tratamientos">Tratamientos</a>
        <a href="#equipo">Equipo</a>
        <a href="#financiacion">Financiación</a>
        <a href="#preguntas">Preguntas</a>
      </nav>
      <div class="top-actions">
        <a class="tel" href="tel:+34910000000">910 000 000</a>
        <a class="btn" href="#cita">Primera visita gratis</a>
      </div>
    </header>

    <section class="hero" id="inicio">
      <div class="hero-text">
        <p class="chip"><span class="dot" aria-hidden="true"></span>Primera visita sin coste</p>
        <h1>Te explicamos qué tienes antes de tocarte nada.</h1>
        <p class="lead">
          Diagnóstico con imagen, presupuesto cerrado por escrito y tú decides. Sin paquetes
          que no has pedido ni tratamientos que puedan esperar.
        </p>
        <div class="hero-actions">
          <a class="btn big" href="#cita">Pedir primera visita</a>
          <a class="btn ghost big" href="#tratamientos">Ver tratamientos</a>
        </div>
        <ul class="pruebas">
          <li><strong>18 años</strong><span>en el barrio</span></li>
          <li><strong>4,9/5</strong><span>en 320 reseñas</span></li>
          <li><strong>10 años</strong><span>garantía en implantes</span></li>
          <li><strong>12 meses</strong><span>sin intereses</span></li>
        </ul>
      </div>

        <div class="hueco">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <circle cx="8.5" cy="10" r="1.6" />
            <path d="m4 17 5-4.5 3.5 3L16 12l4 4" />
          </svg>
          <span>Tu foto aquí · el gabinete o el equipo, 1200 × 900</span>
        </div>
    </section>

    <section class="tratamientos" id="tratamientos">
      <header class="sec-head">
        <div>
          <p class="eyebrow">Tratamientos</p>
          <h2>Explicados en cristiano, con su precio de partida</h2>
        </div>
        <p class="sec-note">
          El precio final sale del estudio de tu caso y se entrega por escrito antes de empezar.
        </p>
      </header>

      <div class="grid">
        {
          tratamientos.map((t) => (
            <article class="card">
              <span class={`icono icono-${t.icono}`} aria-hidden="true" />
              <h3>{t.nombre}</h3>
              <p class="card-texto">{t.texto}</p>
              <p class="card-meta">
                <span class="desde">
                  desde <strong>{t.desde}</strong>
                </span>
                <span class="dura">{t.dura}</span>
              </p>
              <a class="card-cta" href="#cita">
                Pedir cita <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="proceso">
      <header class="sec-head">
        <div>
          <p class="eyebrow">Cómo funciona</p>
          <h2>De la primera visita al alta, sin sorpresas</h2>
        </div>
      </header>
      <ol class="pasos">
        {
          pasos.map((p, i) => (
            <li>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <strong>{p.t}</strong>
              <span>{p.d}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="equipo" id="equipo">
      <header class="sec-head">
        <div>
          <p class="eyebrow">Equipo</p>
          <h2>Quién te atiende, con nombre y número de colegiado</h2>
        </div>
      </header>
      <div class="personas">
        {
          equipo.map((p) => (
            <div class="persona">
              <span class="retrato" aria-hidden="true">
                {p.nombre
                  .split(' ')
                  .filter((w) => !w.includes('.'))
                  .slice(0, 2)
                  .map((w) => w[0])
                  .join('')}
              </span>
              <strong>{p.nombre}</strong>
              <span class="rol">{p.rol}</span>
              <span class="col">{p.num}</span>
              <span class="extra">{p.extra}</span>
            </div>
          ))
        }
      </div>

      <div class="seguros">
        <p class="seguros-titulo">Trabajamos con tu seguro</p>
        <ul>
          {seguros.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </section>

    <section class="financiacion" id="financiacion">
      <div class="fin-grid">
        <div>
          <p class="eyebrow claro">Financiación</p>
          <h2>Que el precio no sea el motivo para no tratarte</h2>
          <p class="fin-texto">
            Hasta 12 meses sin intereses con la propia clínica y hasta 60 meses con financiera.
            Se firma antes de empezar, con el cuadro de cuotas delante y sin comisiones de
            apertura.
          </p>
        </div>
        <div class="fin-ejemplos">
          <p class="fin-titulo">Ejemplos reales</p>
          <ul>
            <li>
              <span>Implante 850 €</span>
              <strong>70,83 €/mes</strong>
              <small>12 meses sin intereses</small>
            </li>
            <li>
              <span>Ortodoncia 2.400 €</span>
              <strong>200 €/mes</strong>
              <small>12 meses sin intereses</small>
            </li>
            <li>
              <span>Carillas 1.740 €</span>
              <strong>145 €/mes</strong>
              <small>12 meses sin intereses</small>
            </li>
          </ul>
          <p class="fin-nota">Ejemplos orientativos sujetos a estudio. TAE 0 % en la modalidad de clínica.</p>
        </div>
      </div>
    </section>

    <section class="casos" id="casos">
      <header class="sec-head">
        <div>
          <p class="eyebrow">Casos</p>
          <h2>Antes y después de pacientes de la clínica</h2>
        </div>
        <p class="sec-note">
          Publicados con permiso firmado. Cada caso indica edad y duración, porque sin eso una
          foto no dice nada.
        </p>
      </header>
      <div class="casos-grid">
        {
          casos.map((caso) => (
            <figure>
              <div class="par">
                <div class="hueco hueco-caso">
                  <span class="etiqueta-foto">Antes</span>
                </div>
                <div class="hueco hueco-caso">
                  <span class="etiqueta-foto">Después</span>
                </div>
              </div>
              <figcaption>
                <strong>{caso.titulo}</strong>
                <span>{caso.detalle}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="tecnologia">
      <div class="tec-grid">
        <div>
          <p class="eyebrow claro">Equipamiento</p>
          <h2>Con qué se trabaja</h2>
          <p class="tec-texto">
            Lo que cambia la experiencia no es el sillón: es no tener que morder pasta para un
            molde y ver tu boca en pantalla mientras te explican lo que pasa.
          </p>
        </div>
        <ul>
          {
            tecnologia.map((t) => (
              <li>
                <strong>{t.nombre}</strong>
                <span>{t.nota}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="garantias">
      <header class="sec-head">
        <div>
          <p class="eyebrow">Garantías</p>
          <h2>Lo que te llevas por escrito</h2>
        </div>
      </header>
      <div class="garantias-grid">
        {
          garantias.map((g) => (
            <div class="garantia">
              <span class="tick" aria-hidden="true">✓</span>
              <strong>{g.t}</strong>
              <span>{g.d}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="resenas">
      <header class="sec-head">
        <div>
          <p class="eyebrow">Reseñas</p>
          <h2>4,9 sobre 5 en 320 reseñas</h2>
        </div>
      </header>
      <div class="resenas-grid">
        {
          resenas.map((r) => (
            <blockquote>
              <p class="estrellas" aria-label="5 sobre 5">
                ★★★★★
              </p>
              <p>{r.t}</p>
              <footer>
                {r.a} · {r.f}
              </footer>
            </blockquote>
          ))
        }
      </div>
    </section>

    <section class="preguntas" id="preguntas">
      <header class="sec-head">
        <div>
          <p class="eyebrow">Preguntas frecuentes</p>
          <h2>Lo que nos preguntáis antes de venir</h2>
        </div>
      </header>
      <div class="faq">
        {
          preguntas.map((p, i) => (
            <details open={i === 0}>
              <summary>{p.q}</summary>
              <p>{p.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="cita" id="cita">
      <div class="cita-grid">
        <div>
          <p class="eyebrow claro">Primera visita</p>
          <h2>Sin coste y sin compromiso</h2>
          <p class="cita-texto">
            Déjanos tus datos y te llamamos para darte hora, normalmente el mismo día. Si
            prefieres, llama tú directamente.
          </p>
          <a class="tel-grande" href="tel:+34910000000">910 000 000</a>
          <div class="donde">
            <p><strong>Calle Alcalá 200, Madrid</strong></p>
            <p>Lunes a viernes 9:00 – 21:00 · Sábados 9:00 – 14:00</p>
            <p>Metro Ventas (L2 y L5) · Parking concertado</p>
          </div>
        </div>

        <form>
          <label>
            Nombre
            <input type="text" placeholder="Nombre y apellidos" required />
          </label>
          <label>
            Teléfono
            <input type="tel" placeholder="600 000 000" required />
          </label>
          <label class="ancho">
            Motivo de la consulta
            <select>
              <option>Revisión y limpieza</option>
              <option>Dolor o urgencia</option>
              <option>Ortodoncia</option>
              <option>Implantes</option>
              <option>Estética dental</option>
              <option>Odontopediatría</option>
            </select>
          </label>
          <label class="ancho">
            Cuándo te viene bien
            <span class="chips">
              <span>Mañanas</span>
              <span>Mediodía</span>
              <span>Tardes</span>
              <span>Sábado</span>
            </span>
          </label>
          <label class="ancho">
            Algo más que debamos saber
            <textarea rows="3" placeholder="Seguro, miedo al dentista, tratamientos previos…"></textarea>
          </label>
          <button type="button">Pedir primera visita</button>
          <p class="form-nota">Te llamamos para confirmar. Tus datos no se usan para publicidad.</p>
        </form>
      </div>
    </section>

    <footer class="foot">
      <div>
        <p class="foot-brand">Clínica Dental Aranda</p>
        <p>Calle Alcalá 200, Madrid · 910 000 000 · hola@clinicaaranda.es</p>
      </div>
      <p class="mini">Plantilla de ejemplo. Nombres, precios, profesionales y reseñas son ficticios.</p>
    </footer>

    <div class="barra-movil">
      <a class="btn ghost" href="tel:+34910000000">Llamar</a>
      <a class="btn" href="#cita">Primera visita</a>
    </div>
  </div>
</DemoLayout>

<style>
  .site {
    --azul: #1b5f9e;
    --azul-claro: #3f8fd6;
    --azul-suave: #e3eef8;
    --fondo: #f7fafc;
    --fondo-2: #eaf2f8;
    --tinta: #12212e;
    --suave: #56697a;
    --linea: rgba(18, 33, 46, 0.1);

    background: var(--fondo);
    color: var(--tinta);
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
    padding-bottom: 5.5rem;
  }

  .top {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.85rem clamp(1.1rem, 4vw, 3.5rem);
    background: rgba(247, 250, 252, 0.96);
    border-bottom: 1px solid var(--linea);
    backdrop-filter: blur(10px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
  }

  .mark {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--azul-claro), var(--azul));
  }

  .brand-text {
    display: grid;
    font-size: 1.06rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .brand-text small {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--suave);
  }

  .top nav {
    display: none;
    gap: 1.5rem;
    font-size: 0.93rem;
  }

  .top nav a {
    color: var(--suave);
    text-decoration: none;
  }

  .top nav a:hover {
    color: var(--azul);
  }

  .top-actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .tel {
    display: none;
    font-size: 0.93rem;
    color: var(--suave);
    text-decoration: none;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 1.3rem;
    border-radius: 10px;
    background: var(--azul);
    color: #fff;
    font-size: 0.94rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
    background: #164e83;
  }

  .btn.ghost {
    background: #fff;
    border: 1px solid var(--linea);
    color: var(--tinta);
  }

  .btn.big {
    min-height: 54px;
    padding: 0 1.9rem;
    font-size: 1rem;
  }

  section {
    padding: clamp(2.6rem, 6vw, 4.5rem) clamp(1.1rem, 4vw, 3.5rem);
  }

  .hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.2rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: var(--azul-suave);
    color: var(--azul);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--azul-claro);
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    max-width: 19ch;
  }

  .lead {
    max-width: 52ch;
    color: var(--suave);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }

  .pruebas {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.8rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .pruebas li {
    display: grid;
    gap: 0.1rem;
    padding: 0.9rem 1.1rem;
    border-radius: 12px;
    background: #fff;
    border: 1px solid var(--linea);
  }

  .pruebas strong {
    font-size: 1.3rem;
    color: var(--azul);
  }

  .pruebas span {
    color: var(--suave);
    font-size: 0.84rem;
  }


  /* --- Huecos de imagen ---
     La plantilla enseña estructura, no fotos de relleno: cada hueco dice qué
     imagen va ahí y con qué proporción, para que el cliente sepa qué mandar. */
  .hueco {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.5rem;
    aspect-ratio: 4 / 3;
    border: 2px dashed rgba(18, 33, 46, 0.22);
    border-radius: 18px;
    background: rgba(18, 33, 46, 0.04);
    color: var(--suave);
    text-align: center;
  }

  .hueco svg {
    width: 34px;
    height: 34px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.75;
  }

  .hueco span {
    font-size: 0.82rem;
    letter-spacing: 0.02em;
  }

  .hueco-ancho {
    aspect-ratio: 16 / 7;
    border-radius: 0 0 28px 28px;
  }

  .hueco-mini {
    aspect-ratio: 1;
    gap: 0;
    border-radius: 12px;
    border-width: 1px;
  }

  .hueco-mini svg {
    width: 18px;
    height: 18px;
  }

  .hueco-mini span {
    display: none;
  }

  .hueco-video {
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    border-width: 1px;

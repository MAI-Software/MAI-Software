---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectArchive from '../components/projects/ProjectArchive.astro';
import { company } from '../data/company';
import { getCategory } from '../data/categories';
import { categoryFaqs } from '../data/faqs';
import { categoryAbout } from '../data/category-copy';
import { getProjects } from '../lib/projects';
import { useTranslations, projectsPath, homePath } from '../i18n/utils';

const locale = 'es';
const category = getCategory('saas');
const projects = await getProjects(locale, 'saas');
const t = useTranslations(locale);
const crumbs = [
  { name: t('nav.home'), path: homePath(locale) },
  { name: t('nav.projects'), path: projectsPath(locale) },
  { name: category.label[locale] },
];
const faqs = categoryFaqs['saas'];
const faqSchema = [
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question[locale],
      acceptedAnswer: { '@type': 'Answer', text: faq.answer[locale] },
    })),
  },
];
---

<BaseLayout
  locale={locale}
  breadcrumbs={crumbs}
  schema={faqSchema}
  title="Desarrollo SaaS y herramientas digitales | MAI Softwares"
  description="Explora herramientas SaaS y aplicaciones web creadas por MAI Softwares para simplificar procesos y resolver problemas reales."
  alternatePath="/en/saas"
>
  <ProjectArchive
    locale={locale}
    breadcrumbs={crumbs}
    about={categoryAbout['saas'][locale]}
    faqs={faqs}
    title="Ideas que *trabajan* contigo."
    intro="Herramientas digitales creadas para resolver tareas reales, simplificar procesos y convertir problemas cotidianos en experiencias mucho más fáciles."
    projects={projects}
    activeCategory="saas"
  />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectArchive from '../components/projects/ProjectArchive.astro';
import { company } from '../data/company';
import { getCategory } from '../data/categories';
import { getProjects } from '../lib/projects';

const locale = 'es';
const category = getCategory('saas');
const projects = await getProjects(locale, 'saas');
---

<BaseLayout
  locale={locale}
  title="Desarrollo SaaS y herramientas digitales | MAI Softwares"
  description="Explora herramientas SaaS y aplicaciones web creadas por MAI Softwares para simplificar procesos y resolver problemas reales."
  alternatePath="/en/saas"
>
  <ProjectArchive
    locale={locale}
    title="Ideas que trabajan contigo."
    intro="Herramientas digitales creadas para resolver tareas reales, simplificar procesos y convertir problemas cotidianos en experiencias mucho más fáciles."
    projects={projects}
    activeCategory="saas"
  />
</BaseLayout>

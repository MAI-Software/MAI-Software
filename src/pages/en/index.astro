---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/home/Hero.astro';
import CategoryIndex from '../../components/home/CategoryIndex.astro';
import ProjectFeed from '../../components/home/ProjectFeed.astro';
import Process from '../../components/home/Process.astro';
import ClientSites from '../../components/home/ClientSites.astro';
import WebOffer from '../../components/home/WebOffer.astro';
import ContactSection from '../../components/home/ContactSection.astro';
import { company } from '../../data/company';
import { getProjects, getFeaturedProject } from '../../lib/projects';
import { getCategory } from '../../data/categories';
import { useTranslations, projectsPath } from '../../i18n/utils';

const locale = 'en';
// The featured project leads the hero stack
const featured = await getFeaturedProject(locale);
const all = await getProjects(locale);
const projects = featured
  ? [featured, ...all.filter((p) => p.data.slug !== featured.data.slug)]
  : all;

const t = useTranslations(locale);
// La portada enseña una fila de cada cosa, no el archivo entero
const games = all.filter((p) => p.data.category === 'game');
const software = all.filter((p) => p.data.category !== 'game').slice(0, 3);
---

<BaseLayout
  locale={locale}
  title={`${company.name} — Game, SaaS & web development`}
  description="Digital product studio: we build video games, SaaS tools and custom websites. See our shipped projects."
  alternatePath="/"
>
  <Hero locale={locale} projects={projects} />
  <CategoryIndex locale={locale} />
  {
    games.length > 0 && (
      <ProjectFeed
        projects={games}
        locale={locale}
        eyebrow={t('feed.games.eyebrow')}
        title={t('feed.games.title')}
        ctaLabel={t('feed.games.all')}
        ctaHref={getCategory('game').path[locale]}
        carousel
        note={t('feed.games.note')}
      />
    )
  }
  {
    software.length > 0 && (
      <ProjectFeed
        projects={software}
        locale={locale}
        eyebrow={t('feed.software.eyebrow')}
        title={t('feed.software.title')}
        ctaLabel={t('feed.all')}
        ctaHref={projectsPath(locale)}
      />
    )
  }
  <Process locale={locale} />
  <ClientSites locale={locale} />
  <WebOffer locale={locale} />
  <ContactSection locale={locale} />
</BaseLayout>

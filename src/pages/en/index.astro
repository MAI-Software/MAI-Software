---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/home/Hero.astro';
import CategoryIndex from '../../components/home/CategoryIndex.astro';
import ProjectFeed from '../../components/home/ProjectFeed.astro';
import Process from '../../components/home/Process.astro';
import ClientSites from '../../components/home/ClientSites.astro';
import StudioIntro from '../../components/home/StudioIntro.astro';
import ContactSection from '../../components/home/ContactSection.astro';
import { company } from '../../data/company';
import { getProjects, getFeaturedProject } from '../../lib/projects';

const locale = 'en';
// The featured project leads the hero stack
const featured = await getFeaturedProject(locale);
const all = await getProjects(locale);
const projects = featured
  ? [featured, ...all.filter((p) => p.data.slug !== featured.data.slug)]
  : all;
---

<BaseLayout
  locale={locale}
  title={`${company.name} — Game, SaaS & web development`}
  description="Digital product studio: we build video games, SaaS tools and custom websites. See our shipped projects."
  alternatePath="/"
>
  <Hero locale={locale} projects={projects} />
  <CategoryIndex locale={locale} />
  {projects.length > 0 && <ProjectFeed projects={projects} locale={locale} />}
  <Process locale={locale} />
  <ClientSites locale={locale} />
  <StudioIntro locale={locale} />
  <ContactSection locale={locale} />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectArchive from '../components/projects/ProjectArchive.astro';
import { company } from '../data/company';
import { getCategory } from '../data/categories';
import { getProjects } from '../lib/projects';

const locale = 'es';
const category = getCategory('calc');
const projects = await getProjects(locale, 'calc');
---

<BaseLayout
  locale={locale}
  title="Calculadoras y herramientas online | MAI Software"
  description="Descubre calculadoras y herramientas online creadas por MAI Software para convertir cálculos complejos en respuestas claras y rápidas."
  alternatePath="/en/calculators"
>
  <ProjectArchive
    locale={locale}
    title="Hacemos fácil entender lo difícil."
    intro="Creamos herramientas que transforman números, fórmulas y decisiones complejas en respuestas claras que puedes obtener en segundos."
    projects={projects}
    activeCategory="calc"
  />
</BaseLayout>

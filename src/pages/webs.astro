---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectArchive from '../components/projects/ProjectArchive.astro';
import { company } from '../data/company';
import { getCategory } from '../data/categories';
import { getProjects } from '../lib/projects';

const locale = 'es';
const category = getCategory('web');
const projects = await getProjects(locale, 'web');
---

<BaseLayout
  locale={locale}
  title="Diseño y desarrollo web | MAI Softwares"
  description="Webs rápidas, claras y cuidadas desarrolladas por MAI Softwares para proyectos, negocios e ideas que necesitan una presencia digital propia."
  alternatePath="/en/webs"
>
  <ProjectArchive
    locale={locale}
    title="Ideas que encuentran su lugar en la web."
    intro="Diseñamos y desarrollamos webs rápidas, claras y cuidadas para que proyectos, negocios e ideas puedan presentarse como merecen."
    projects={projects}
    activeCategory="web"
  />
</BaseLayout>

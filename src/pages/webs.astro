---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectArchive from '../components/projects/ProjectArchive.astro';
import { company } from '../data/company';
import { getCategory } from '../data/categories';
import { categoryFaqs } from '../data/faqs';
import { categoryAbout } from '../data/category-copy';
import { getProjects } from '../lib/projects';
import { useTranslations, projectsPath, homePath } from '../i18n/utils';

const locale = 'es';
const category = getCategory('web');
const projects = await getProjects(locale, 'web');
const t = useTranslations(locale);
const crumbs = [
  { name: t('nav.home'), path: homePath(locale) },
  { name: t('nav.projects'), path: projectsPath(locale) },
  { name: category.label[locale] },
];
const faqs = categoryFaqs['web'];
const faqSchema = [
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question[locale],
      acceptedAnswer: { '@type': 'Answer', text: faq.answer[locale] },
    })),
  },
];
---

<BaseLayout
  locale={locale}
  breadcrumbs={crumbs}
  schema={faqSchema}
  title="Diseño y desarrollo web | MAI Softwares"
  description="Webs rápidas, claras y cuidadas desarrolladas por MAI Softwares para proyectos, negocios e ideas que necesitan una presencia digital propia."
  alternatePath="/en/webs"
>
  <ProjectArchive
    locale={locale}
    breadcrumbs={crumbs}
    about={categoryAbout['web'][locale]}
    faqs={faqs}
    title="Ideas que encuentran su lugar en la *web*."
    intro="Diseñamos y desarrollamos webs rápidas, claras y cuidadas para que proyectos, negocios e ideas puedan presentarse como merecen."
    projects={projects}
    activeCategory="web"
  />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectArchive from '../../components/projects/ProjectArchive.astro';
import { company } from '../../data/company';
import { useTranslations, homePath } from '../../i18n/utils';
import { getProjects } from '../../lib/projects';

const locale = 'es';
const t = useTranslations(locale);
const crumbs = [
  { name: t('nav.home'), path: homePath(locale) },
  { name: t('nav.projects') },
];
const projects = await getProjects(locale);
---

<BaseLayout
  locale={locale}
  breadcrumbs={crumbs}
  title="Proyectos de MAI Softwares | Web, SaaS y videojuegos"
  description="Explora los proyectos de MAI Softwares: webs, herramientas, SaaS, calculadoras y videojuegos creados a partir de ideas reales."
  alternatePath="/en/projects"
>
  <ProjectArchive
    locale={locale}
    breadcrumbs={crumbs}
    title={t('projects.title')}
    intro={t('projects.intro')}
    projects={projects}
  />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectArchive from '../../components/projects/ProjectArchive.astro';
import { company } from '../../data/company';
import { useTranslations } from '../../i18n/utils';
import { getProjects } from '../../lib/projects';

const locale = 'es';
const t = useTranslations(locale);
const projects = await getProjects(locale);
---

<BaseLayout
  locale={locale}
  title="Proyectos de MAI Software | Web, SaaS y videojuegos"
  description="Explora los proyectos de MAI Software: webs, herramientas, SaaS, calculadoras y videojuegos creados a partir de ideas reales."
  alternatePath="/en/projects"
>
  <ProjectArchive
    locale={locale}
    title={t('projects.title')}
    intro={t('projects.intro')}
    projects={projects}
  />
</BaseLayout>

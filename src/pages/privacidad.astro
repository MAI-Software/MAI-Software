---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalSections from '../components/global/LegalSections.astro';
import { company } from '../data/company';
import { privacyPolicy } from '../data/legal-copy';
import { useTranslations } from '../i18n/utils';

const locale = 'es';
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title={`${t('privacy.title')} — ${company.name}`}
  description={t('privacy.intro')}
  alternatePath="/en/privacy"
>
  <section class="section">
    <div class="container">
      <div class="container-reading legal-page">
        <h1>{t('privacy.title')}</h1>
        <p class="lead">{t('privacy.intro')}</p>

        <LegalSections locale={locale} sections={privacyPolicy} />

        <p class="legal-updated">{t('legal.updated')}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-page {
    display: grid;
    gap: clamp(var(--space-5), 4vw, var(--space-7));
  }

  .legal-updated {
    color: var(--text-soft);
    font-size: var(--font-size-sm);
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectArchive from '../components/projects/ProjectArchive.astro';
import { company } from '../data/company';
import { getCategory } from '../data/categories';
import { getProjects } from '../lib/projects';

const locale = 'es';
const category = getCategory('game');
const projects = await getProjects(locale, 'game');
---

<BaseLayout
  locale={locale}
  title="Desarrollo de videojuegos | MAI Softwares"
  description="Descubre videojuegos y experiencias interactivas desarrolladas por MAI Softwares para web, móvil y otros formatos digitales."
  alternatePath="/en/games"
>
  <ProjectArchive
    locale={locale}
    title="Ideas hechas para jugar."
    intro="Proyectos donde diseño, código e interacción se encuentran para crear experiencias que solo tienen sentido cuando alguien empieza a jugar."
    projects={projects}
    activeCategory="game"
  />
</BaseLayout>
